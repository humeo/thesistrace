FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY agent/package.json ./agent/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY contracts ./contracts
COPY agent ./agent
RUN rm -rf /app/agent/dist /app/agent/tsconfig.tsbuildinfo \
    && pnpm --dir agent build
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm --filter thesistrace-agent-host deploy --prod /agent-runtime

FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8

ENV NODE_ENV=production
WORKDIR /app/agent

COPY --from=build --chown=node:node /agent-runtime/package.json ./package.json
COPY --from=build --chown=node:node /agent-runtime/node_modules ./node_modules
COPY --from=build --chown=node:node /app/agent/dist ./dist
COPY --from=build --chown=node:node /app/agent/schema ./schema
COPY --from=build --chown=node:node /app/contracts /app/contracts

USER node
EXPOSE 8400
CMD ["node", "dist/server.js"]
