{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "System checks",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "thesistrace_health_check{view=\"system\"}",
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Worker readiness and heartbeats",
      "type": "timeseries",
      "targets": [
        {
          "expr": "thesistrace_service_ready",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "expr": "time() - thesistrace_service_heartbeat_timestamp_seconds",
          "legendFormat": "heartbeat age {{instance}}",
          "refId": "B"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Queue, capacity, and disk pressure",
      "type": "timeseries",
      "targets": [
        {
          "expr": "thesistrace_health_measurement{view=\"system\"}",
          "legendFormat": "{{measurement}}",
          "refId": "A"
        },
        {
          "expr": "thesistrace_storage_used_ratio",
          "legendFormat": "disk used ratio",
          "refId": "B"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Dropped external trace export",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(otelcol_exporter_send_failed_spans[5m])",
          "legendFormat": "failed spans {{exporter}}",
          "refId": "A"
        },
        {
          "expr": "rate(otelcol_exporter_enqueue_failed_spans[5m])",
          "legendFormat": "dropped spans {{exporter}}",
          "refId": "B"
        },
        {
          "expr": "otelcol_exporter_queue_size{exporter=\"otlp/external\"} / otelcol_exporter_queue_capacity{exporter=\"otlp/external\"}",
          "legendFormat": "external queue utilization",
          "refId": "C"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "Expected Worker slots online",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(up{job=\"service-probes\",instance=~\"compute-worker-[1-4]:9100\"}) or vector(0)) / 4",
          "legendFormat": "compute slots",
          "refId": "A"
        },
        {
          "expr": "min(up{job=\"service-probes\"}) or vector(0)",
          "legendFormat": "all role probes",
          "refId": "B"
        },
        {
          "expr": "min(thesistrace_service_ready) or vector(0)",
          "legendFormat": "role readiness",
          "refId": "C"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    }
  ],
  "schemaVersion": 41,
  "tags": ["thesistrace", "system-health"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "ThesisTrace System Health",
  "uid": "thesistrace-system-health",
  "version": 1
}
