{
  "version": 1,
  "characteristic": "ip",
  "rules": [
    {
      "name": "registration",
      "methods": ["POST"],
      "paths": ["/api/auth/users"],
      "requests": 10,
      "period_seconds": 60,
      "mitigation_timeout_seconds": 600,
      "action": "block"
    },
    {
      "name": "login",
      "methods": ["POST"],
      "paths": ["/api/auth/sessions"],
      "requests": 20,
      "period_seconds": 60,
      "mitigation_timeout_seconds": 600,
      "action": "block"
    },
    {
      "name": "verification",
      "methods": ["GET", "POST"],
      "paths": [
        "/api/auth/email/send-verification",
        "/api/auth/email/verify",
        "/api/auth/email/verify-link"
      ],
      "requests": 10,
      "period_seconds": 60,
      "mitigation_timeout_seconds": 600,
      "action": "block"
    },
    {
      "name": "recovery",
      "methods": ["GET", "POST"],
      "paths": [
        "/api/auth/email/send-reset-password",
        "/api/auth/email/exchange-reset-password-token",
        "/api/auth/email/reset-password",
        "/api/auth/email/reset-password-link"
      ],
      "requests": 10,
      "period_seconds": 60,
      "mitigation_timeout_seconds": 600,
      "action": "block"
    }
  ]
}
