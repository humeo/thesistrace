{
	admin off
	http_port 8080
	https_port 8443
	servers {
		trusted_proxies static {$THESISTRACE_EDGE_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

:2019 {
	respond /live 200
	respond /ready 200
	respond 404
}

{$THESISTRACE_SITE_ADDRESS:https://localhost} {
	tls {$THESISTRACE_ORIGIN_TLS}
	encode zstd gzip

	@untrusted_origin not remote_ip {$THESISTRACE_EDGE_TRUSTED_PROXIES}
	handle @untrusted_origin {
		respond 403
	}

	@private_edge_paths path /api/storage /api/storage/* /api/v1/objects /api/v1/objects/* /api/auth/admin /api/auth/admin/*
	handle @private_edge_paths {
		respond 404
	}

	@thesistrace_api path /api/v1/*
	handle @thesistrace_api {
		reverse_proxy api:8000 {
			header_up -CF-Connecting-IP
		}
	}

	@insforge_auth_post {
		method POST
		path /api/auth/users /api/auth/sessions /api/auth/refresh /api/auth/logout /api/auth/email/send-verification /api/auth/email/verify /api/auth/email/send-reset-password /api/auth/email/exchange-reset-password-token /api/auth/email/reset-password
	}
	handle @insforge_auth_post {
		reverse_proxy insforge:7130 {
			header_up -CF-Connecting-IP
		}
	}

	@insforge_auth_get {
		method GET
		path /api/auth/public-config /api/auth/anon-key /api/auth/sessions/current /api/auth/email/verify-link /api/auth/email/reset-password-link /.well-known/jwks.json /api/.well-known/jwks.json
	}
	handle @insforge_auth_get {
		reverse_proxy insforge:7130 {
			header_up -CF-Connecting-IP
		}
	}

	handle /api/auth/* {
		respond 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
