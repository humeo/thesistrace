{
  "name": "thesistrace",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "bootstrap": "./scripts/dev-runtime bootstrap",
    "dev": "./scripts/dev-runtime watch",
    "dev:logs": "./scripts/dev-runtime logs",
    "dev:up": "./scripts/dev-runtime up",
    "dev:reset": "./scripts/dev-runtime reset",
    "dev:stop": "./scripts/dev-runtime stop",
    "test": "uv run ruff check src tests && uv run pytest -q tests/kernel tests/architecture tests/adapters && pnpm --dir web typecheck && pnpm --dir web test:shell",
    "test:e2e": "./scripts/test-runtime e2e",
    "test:integration": "./scripts/test-runtime integration",
    "check": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "check:live-tushare": "uv run python scripts/check_live_tushare.py"
  }
}
