{
  "name": "thesistrace",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "config:init": "node tooling/config/cli.mjs init",
    "config:check": "node tooling/dev/runtime.mjs development validate",
    "config:run": "node tooling/config/cli.mjs run",
    "bootstrap": "node tooling/dev/runtime.mjs development bootstrap",
    "dev": "node tooling/dev/runtime.mjs development watch",
    "dev:logs": "node tooling/dev/runtime.mjs development logs",
    "dev:up": "node tooling/dev/runtime.mjs development up",
    "dev:reset": "node tooling/dev/runtime.mjs development reset",
    "dev:erase": "node tooling/dev/runtime.mjs development erase",
    "dev:stop": "node tooling/dev/runtime.mjs development stop",
    "test": "node tooling/test/quick.mjs",
    "test:cleanup": "./tooling/test/cli.mjs cleanup",
    "test:e2e": "node tooling/test/run-e2e.mjs",
    "test:caddy-image-smoke": "./tooling/test/caddy-image.mjs",
    "test:image-smoke": "./tooling/test/cli.mjs image-smoke && pnpm --dir apps/auth test:image-smoke && pnpm --dir apps/agent test:image-smoke && pnpm test:caddy-image-smoke",
    "test:integration": "./tooling/test/cli.mjs integration && pnpm --dir apps/auth test:integration && pnpm --dir apps/agent test:integration",
    "test:codex-mcp": "./tooling/test/cli.mjs codex-mcp",
    "check": "pnpm test && pnpm test:browser && pnpm test:integration && pnpm test:e2e",
    "check:performance": "./tooling/test/cli.mjs performance",
    "check:release": "./tooling/test/release-gate.mjs",
    "check:live-tushare": "node tooling/config/cli.mjs run uv run --project apps/core python apps/core/tools/check_live_tushare.py",
    "test:browser": "pnpm --dir apps/web test:browser",
    "prod": "node tooling/dev/runtime.mjs production",
    "dev:status": "node tooling/dev/runtime.mjs development status",
    "config:template": "node tooling/config/cli.mjs template"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "typescript": "~5.7.2"
  },
  "type": "module"
}
