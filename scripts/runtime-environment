# Shared by lifecycle and Operator wrappers; requires repo_root.
# Compose parses the file. Never source it as shell code.

clear_compose_environment() {
  # Discover every interpolated variable from the maintained topology, including
  # optional values. New Compose settings cannot silently escape this boundary.
  runtime_names=$(grep -hoE '\$\{[A-Z][A-Z0-9_]*' \
    "$repo_root/deploy/core/compose.yaml" \
    "$repo_root/deploy/core/compose.dev.yaml" \
    "$repo_root/deploy/core/compose.production.yaml" \
    | sed 's/^${//' | sort -u)
  for runtime_name in $runtime_names; do
    unset "$runtime_name"
  done
}

validate_environment_literals() {
  # One literal NAME=value per line. Excluding interpolation makes the file
  # authoritative even when an unrelated parent shell contains credentials.
  awk '
    NR == FNR {
      if ($0 ~ /^[A-Z][A-Z0-9_]*=/) known[substr($0, 1, index($0, "=") - 1)] = 1
      next
    }
    /^[[:space:]]*($|#)/ { next }
    {
      separator = index($0, "=")
      if (separator < 2) exit 1
      key = substr($0, 1, separator - 1)
      value = substr($0, separator + 1)
      if (key !~ /^[A-Z][A-Z0-9_]*$/ || seen[key]++) exit 1
      if (!(key in known) && key != "THESISTRACE_AGENT_MODEL_REGISTRY") exit 1
      if (value ~ /[$#]/ || value ~ /\r/ || value ~ /^[[:space:]"\047]/ \
          || value ~ /[[:space:]]$/) exit 1
    }
  ' "$repo_root/.env.example" "$environment_file"
}
