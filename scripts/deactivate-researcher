#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
base_file="$repo_root/deploy/core/compose.yaml"
production_file="$repo_root/deploy/core/compose.production.yaml"
environment_file=${THESISTRACE_PRODUCTION_ENV_FILE-}

fail_usage() {
  echo "usage: THESISTRACE_PRODUCTION_ENV_FILE=/private/env $0 {--email EMAIL|--researcher-id UUID}" >&2
  exit 2
}

test -n "$environment_file" || fail_usage
test "$#" -eq 2 || fail_usage
identity_flag=$1
identity_value=$2
case "$identity_flag" in
  --email | --researcher-id) ;;
  *) fail_usage ;;
esac
test -n "$identity_value" || fail_usage

compose_run() {
  docker compose \
    --project-name thesistrace \
    --env-file "$environment_file" \
    --file "$base_file" \
    --file "$production_file" \
    run --rm --no-deps -T "$@"
}

resolved=$(compose_run auth node dist/operator.js resolve \
  "$identity_flag" "$identity_value")
printf '%s\n' "$resolved" | grep -Eq \
  '^\{"command":"resolve","researcher_id":"[0-9a-f-]{36}","status":"resolved"\}$' \
  || exit 1
researcher_id=$(printf '%s\n' "$resolved" | sed -n \
  's/^.*"researcher_id":"\([0-9a-f-][0-9a-f-]*\)".*$/\1/p')
test -n "$researcher_id" || exit 1

inspection=$(compose_run api thesistrace-core-access-inspect \
  active-daily-tracks --researcher-id "$researcher_id")
printf '%s\n' "$inspection" | grep -Eq \
  '^\{"active_daily_track_count":[0-9]+,"researcher_id":"[0-9a-f-]{36}","status":"inspected"\}$' \
  || exit 1
active_daily_track_count=$(printf '%s\n' "$inspection" | sed -n \
  's/^.*"active_daily_track_count":\([0-9][0-9]*\).*$/\1/p')
inspected_researcher_id=$(printf '%s\n' "$inspection" | sed -n \
  's/^.*"researcher_id":"\([0-9a-f-][0-9a-f-]*\)".*$/\1/p')
test "$inspected_researcher_id" = "$researcher_id" || exit 1

mutation=$(compose_run auth node dist/operator.js deactivate \
  --researcher-id "$researcher_id")
printf '%s\n' "$mutation" | grep -Eq \
  '^\{"command":"deactivate","researcher_id":"[0-9a-f-]{36}","status":"(updated|no_change)"\}$' \
  || exit 1
mutation_status=$(printf '%s\n' "$mutation" | sed -n \
  's/^.*"status":"\(updated\|no_change\)".*$/\1/p')

printf '{"active_daily_track_count":%s,"command":"deactivate","researcher_id":"%s","status":"%s"}\n' \
  "$active_daily_track_count" "$researcher_id" "$mutation_status"
