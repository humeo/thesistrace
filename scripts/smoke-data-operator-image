#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
base_file="$repo_root/deploy/core/compose.yaml"
test_file="$repo_root/deploy/core/compose.test-run.yaml"
replay="$repo_root/tests/fixtures/tushare-bootstrap-replay-v2.json"
project_name="thesistrace-test-operator-image-$$"
bucket_name="$project_name"
data_mount=$(mktemp -d "${TMPDIR:-/tmp}/thesistrace-data-operator-smoke.XXXXXX")

compose() {
  COMPOSE_ANSI=never COMPOSE_PROGRESS=plain \
    THESISTRACE_TEST_BUCKET="$bucket_name" \
    THESISTRACE_TEST_DATA_MOUNT="$data_mount" \
    docker compose \
    --project-name "$project_name" \
    --file "$base_file" \
    --file "$test_file" \
    "$@"
}

cleanup() {
  status=$?
  trap - EXIT INT TERM
  compose down --volumes --remove-orphans
  rm -rf -- "$data_mount"
  exit "$status"
}

trap cleanup EXIT INT TERM
compose config --quiet
compose build migrate
docker image tag "$project_name-migrate" "$project_name-api"
docker image tag "$project_name-migrate" "$project_name-worker"
compose up --detach --wait --wait-timeout 300 postgres rustfs migrate
compose run --rm --no-deps \
  --volume "$replay:/operator/bootstrap-replay.json:ro" \
  api thesistrace-data-operator bootstrap \
  --idempotency-key image-bootstrap \
  --as-of 2026-08-03T18:00:00+08:00 \
  --replay /operator/bootstrap-replay.json
compose run --rm --no-deps \
  --volume "$replay:/operator/bootstrap-replay.json:ro" \
  api thesistrace-data-operator bootstrap \
  --idempotency-key image-bootstrap \
  --as-of 2026-08-03T18:00:00+08:00 \
  --replay /operator/bootstrap-replay.json
compose up --detach --wait --wait-timeout 300 api worker
compose restart api worker
compose up --detach --wait --wait-timeout 300 api worker
compose exec --no-TTY api python -c \
  "from thesistrace.data import MountedDatasetHeadStore; h = MountedDatasetHeadStore('/var/lib/thesistrace/canonical-data').current(); assert h is not None and h.data_through_session == '2026-08-03'"
