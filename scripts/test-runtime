    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase image-smoke-auth-session provision_image_smoke_auth
    run_phase image-smoke-health verify_image_health initial
    run_phase image-smoke-caddy-single-origin verify_caddy_single_origin
    run_phase image-smoke-caddy-backend-independence \
      verify_caddy_backend_independence
    run_phase image-smoke-postgresql-readiness \
      verify_service_readiness_outage postgres postgresql
    run_phase image-smoke-rustfs-readiness \
