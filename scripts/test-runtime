    run_phase image-smoke-postgresql-readiness \
      verify_service_readiness_outage postgres postgresql
    run_phase image-smoke-rustfs-readiness \
      verify_service_readiness_outage rustfs rustfs
    run_phase image-smoke-dataset-readiness verify_dataset_readiness_outage
    run_phase image-smoke-workers compose up --detach --no-build \
      --wait --wait-timeout 120 \
      research-worker batch-research-worker tracking-worker
    network_internal=$(docker network inspect "${project_name}_default" \
      --format '{{.Internal}}')
    test "$network_internal" = true
    printf 'internal=%s\n' "$network_internal" >"$evidence_dir/network.txt"
    compose images --format json >"$evidence_dir/images.jsonl"
    backend_image=$(runtime_image_name initialize)
    image_revision=$(docker image inspect "$backend_image" --format '{{.Id}}')
    compose ps --all >"$evidence_dir/compose-ps-before-restart.txt"
    run_phase image-smoke-before compose run --rm --no-deps -T \
      -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
