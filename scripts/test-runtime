    run_phase image-smoke-api-logs capture_api_log_evidence
    run_phase image-smoke-worker-event-contract compose run --rm --no-deps -T \
      -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
