#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
base_file="$repo_root/deploy/core/compose.yaml"
test_file="$repo_root/deploy/core/compose.test-run.yaml"
state_root=${THESISTRACE_TEST_STATE_ROOT:-"$repo_root/.local/test-runs"}
canonical_prefix=thesistrace-test-

new_run_id() {
  timestamp=$(date -u +%Y%m%dt%H%M%Sz)
  random_suffix=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s-%s-%s\n' "$timestamp" "$$" "$random_suffix"
}

refuse_project() {
  shown_name=${project_name:-<empty>}
  echo "refusing non-canonical Test project: $shown_name" >&2
  exit 2
}

validate_test_project() {
  case "$project_name" in
    "$canonical_prefix"*) ;;
    *) refuse_project ;;
  esac
  run_id=${project_name#"$canonical_prefix"}
  printf '%s\n' "$run_id" \
    | grep -Eq '^[0-9]{8}t[0-9]{6}z-[0-9]+-[0-9a-f]{8}$' \
    || refuse_project
  test "$project_name" != "thesistrace-dev" || refuse_project
}

validate_cleanup_target() {
  validate_test_project
  target_metadata="$state_root/$run_id/run.txt"
  if [ ! -f "$target_metadata" ] \
    || ! grep -Fqx "project_name=$project_name" "$target_metadata"; then
    echo "refusing Test cleanup without matching run metadata: $project_name" >&2
    exit 2
  fi
}

compose() {
  validate_test_project
  COMPOSE_ANSI=never COMPOSE_PROGRESS=plain \
    THESISTRACE_TEST_BUCKET="$bucket_name" \
    THESISTRACE_TEST_DATA_MOUNT="$data_mount" \
    docker compose \
    --project-name "$project_name" \
    --file "$base_file" \
    --file "$test_file" \
    "$@"
}

mapped_port() {
  service=$1
  container_port=$2
  address=$(compose port "$service" "$container_port")
  port=${address##*:}
  case "$port" in
    '' | *[!0-9]*)
      echo "could not resolve $service port from: $address" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$port"
}

run_with_environment() {
  THESISTRACE_DATABASE_URL="postgresql://thesistrace:thesistrace-test@127.0.0.1:$postgres_port/thesistrace" \
  THESISTRACE_S3_ENDPOINT_URL="http://127.0.0.1:$s3_port" \
  THESISTRACE_S3_ACCESS_KEY_ID=rustfsadmin \
  THESISTRACE_S3_SECRET_ACCESS_KEY=rustfsadmin \
  THESISTRACE_S3_BUCKET="$bucket_name" \
  THESISTRACE_S3_REGION=us-east-1 \
  THESISTRACE_DATA_MOUNT="$data_mount" \
  THESISTRACE_TEST_PROJECT_NAME="$project_name" \
    "$@"
}

run_playwright() {
  THESISTRACE_TEST_WEB_ORIGIN="http://127.0.0.1:$web_port" \
  THESISTRACE_TEST_EVIDENCE_DIR="$evidence_dir" \
    "$@"
}

capture_evidence() {
  mkdir -p "$evidence_dir"
  compose ps --all >"$evidence_dir/compose-ps.txt" 2>&1 || true
  compose logs --no-color --timestamps >"$evidence_dir/compose-logs.txt" 2>&1 || true
  compose ps --all --quiet | while IFS= read -r container_id; do
    test -n "$container_id" || continue
    docker inspect "$container_id" || true
  done >"$evidence_dir/container-inspect.txt" 2>&1
}

cleanup_project() {
  validate_cleanup_target
  compose_status=0
  compose down --volumes --remove-orphans || compose_status=$?
  mount_status=0
  rm -rf -- "$state_root/$run_id/canonical-data" || mount_status=$?
  if [ "$compose_status" -ne 0 ]; then
    return "$compose_status"
  fi
  return "$mount_status"
}

handle_signal() {
  requested_status=$1
  interrupted_status=$requested_status
  if [ -n "$active_pid" ]; then
    kill -TERM "-$active_pid" 2>/dev/null \
      || kill -TERM "$active_pid" 2>/dev/null \
      || true
  else
    exit "$requested_status"
  fi
}

run_managed() {
  active_pid=
  set -m
  (
    trap '' INT
    "$@"
  ) &
  active_pid=$!
  set +m

  set +e
  wait "$active_pid" 2>/dev/null
  child_status=$?
  set -e
  active_pid=
  if [ -n "$interrupted_status" ]; then
    return "$interrupted_status"
  fi
  return "$child_status"
}

finish() {
  status=$?
  trap - EXIT
  trap '' INT TERM
  set +e
  if [ "$status" -ne 0 ]; then
    capture_evidence
  fi
  if [ "$status" -ne 0 ] && [ "$keep_environment" = true ]; then
    echo "preserved failing Test project $project_name" >&2
    printf 'cleanup_status=kept\n' >>"$run_metadata"
  else
    cleanup_project
    cleanup_status=$?
    printf 'cleanup_status=%s\n' "$cleanup_status" >>"$run_metadata"
    if [ "$cleanup_status" -ne 0 ]; then
      echo "cleanup failed for Test project $project_name (status $cleanup_status)" >&2
    fi
    if [ "$status" -eq 0 ] && [ "$cleanup_status" -ne 0 ]; then
      status=$cleanup_status
    fi
  fi
  printf 'status=%s\n' "$status" >>"$run_metadata"
  exit "$status"
}

command=${1:-}
case "$command" in
  identity)
    printf '%s%s\n' "$canonical_prefix" "$(new_run_id)"
    exit 0
    ;;
  cleanup)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    cleanup_project
    exit 0
    ;;
  restart-postgres)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    validate_cleanup_target
    compose restart postgres >&2
    readiness_attempt=0
    until compose exec -T postgres pg_isready -U thesistrace -d thesistrace >/dev/null 2>&1; do
      readiness_attempt=$((readiness_attempt + 1))
      if [ "$readiness_attempt" -ge 60 ]; then
        echo "PostgreSQL did not become ready after restart" >&2
        exit 1
      fi
      sleep 1
    done
    mapped_port postgres 5432
    exit 0
    ;;
  integration | e2e) ;;
  *)
    echo "usage: $0 {identity|cleanup|restart-postgres|integration|e2e [--keep-environment]}" >&2
    exit 2
    ;;
esac
shift

keep_environment=false
case "${1:-}" in
  '') ;;
  --keep-environment)
    keep_environment=true
    shift
    ;;
  *)
    echo "unknown $command option: $1" >&2
    exit 2
    ;;
esac
test "$#" -eq 0 || {
  echo "$command accepts only --keep-environment" >&2
  exit 2
}

run_id=$(new_run_id)
project_name="$canonical_prefix$run_id"
bucket_name="$canonical_prefix$run_id"
run_root="$state_root/$run_id"
data_mount="$run_root/canonical-data"
evidence_dir="$run_root/evidence"
pytest_report="$evidence_dir/pytest.xml"
database_restart_report="$evidence_dir/pytest-database-restart.xml"
run_metadata="$run_root/run.txt"
validate_test_project
mkdir -p "$evidence_dir" "$data_mount"
printf 'run_id=%s\nproject_name=%s\n' "$run_id" "$project_name" >"$run_metadata"
printf 'test_kind=%s\n' "$command" >>"$run_metadata"
echo "Test run: $run_id"
echo "Compose project: $project_name"

trap finish EXIT
active_pid=
interrupted_status=
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

compose config --quiet
case "$command" in
  integration)
    run_managed compose up --detach --build --wait --wait-timeout 300 \
      postgres rustfs migrate
    run_managed compose wait migrate
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    printf 'postgres_port=%s\ns3_port=%s\n' "$postgres_port" "$s3_port" >>"$run_metadata"
    run_managed run_with_environment uv run pytest -q tests/integration tests/acceptance \
      -m "not database_restart" \
      --junitxml="$pytest_report"
    postgres_port=$(mapped_port postgres 5432)
    run_managed run_with_environment env THESISTRACE_DATABASE_RESTART_PHASE=1 \
      uv run pytest -q tests/acceptance/test_core_definition_dates.py \
      -m database_restart --junitxml="$database_restart_report"
    ;;
  e2e)
    run_managed compose up --detach --build --wait --wait-timeout 300 \
      postgres rustfs migrate
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_managed run_with_environment uv run thesistrace-migrate
    run_managed run_with_environment uv run python \
      tests/browser/prepare_current_data.py
    run_managed compose up --detach --build --wait --wait-timeout 300 \
      api worker web
    api_port=$(mapped_port api 8100)
    web_port=$(mapped_port web 5173)
    printf 'postgres_port=%s\ns3_port=%s\napi_port=%s\nweb_port=%s\n' \
      "$postgres_port" "$s3_port" "$api_port" "$web_port" >>"$run_metadata"
    run_managed run_playwright bun run --cwd web test:e2e
    ;;
esac
