      -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
      -e THESISTRACE_TEST_SMOKE_STATE="$smoke_state" \
      initialize python /smoke/production_image_smoke.py persisted \
      >"$evidence_dir/smoke-persisted.json" \
      2>"$evidence_dir/smoke-persisted.stderr.log"
