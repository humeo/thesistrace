mcp_verifying_public_jwk='{"alg":"EdDSA","crv":"Ed25519","kid":"test-signing-key-01","kty":"OKP","use":"sig","x":"3d8K_V0qubfzURRlfRFt44Yk4LeNW6HkQMaeiPIhJA8"}'
compose_cleanup_required=true

new_run_id() {
  timestamp=$(date -u +%Y%m%dt%H%M%Sz)
  random_suffix=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s-%s-%s\n' "$timestamp" "$$" "$random_suffix"
}

refuse_project() {
  shown_name=${project_name:-<empty>}
  echo "refusing non-canonical Test project: $shown_name" >&2
  exit 2
}

validate_test_project() {
  case "$project_name" in
    "$canonical_prefix"*) ;;
    *) refuse_project ;;
  esac
  run_id=${project_name#"$canonical_prefix"}
  printf '%s\n' "$run_id" \
    | grep -Eq '^[0-9]{8}t[0-9]{6}z-[0-9]+-[0-9a-f]{8}$' \
    || refuse_project
  test "$project_name" != "thesistrace-dev" || refuse_project
}

validate_cleanup_target() {
  validate_test_project
  target_metadata="$state_root/$run_id/run.txt"
  if [ ! -f "$target_metadata" ] \
    || ! grep -Fqx "project_name=$project_name" "$target_metadata"; then
    echo "refusing Test cleanup without matching run metadata: $project_name" >&2
    exit 2
  fi
}

set_test_origin() {
  case "${caddy_port:-}" in
    '' | *[!0-9]*)
      echo "invalid Test Caddy port" >&2
      exit 2
      ;;
  esac
  public_origin="http://127.0.0.1:$caddy_port"
  mcp_issuer_url="$public_origin/api/auth"
  mcp_resource_url="$public_origin/mcp"
  auth_secret="test-only-$run_id-auth-secret-with-at-least-32-characters"
  mcp_allowed_hosts="[\"api:8100\",\"127.0.0.1:$caddy_port\"]"
  mcp_allowed_origins="[\"$public_origin\"]"
}

load_test_origin() {
  caddy_port=$(sed -n 's/^caddy_port=//p' "$target_metadata")
  test -n "$caddy_port" || {
    echo "missing Test Caddy port metadata: $project_name" >&2
    exit 2
  }
  set_test_origin
}

acquire_test_origin() {
  caddy_port=$(uv run python "$locked_port_allocator" acquire \
    --lock-root "$port_lock_root" --owner "$project_name")
  set_test_origin
}

release_test_origin() {
  uv run python "$locked_port_allocator" release \
    --lock-root "$port_lock_root" --owner "$project_name" --port "$caddy_port"
}

