#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
base_file="$repo_root/deploy/core/compose.yaml"
test_file="$repo_root/deploy/core/compose.test-run.yaml"
image_smoke_file="$repo_root/deploy/core/compose.image-smoke.yaml"
state_root=${THESISTRACE_TEST_STATE_ROOT:-"$repo_root/.local/test-runs"}
canonical_prefix=thesistrace-test-

new_run_id() {
  timestamp=$(date -u +%Y%m%dt%H%M%Sz)
  random_suffix=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s-%s-%s\n' "$timestamp" "$$" "$random_suffix"
}

refuse_project() {
  shown_name=${project_name:-<empty>}
  echo "refusing non-canonical Test project: $shown_name" >&2
  exit 2
}

validate_test_project() {
  case "$project_name" in
    "$canonical_prefix"*) ;;
    *) refuse_project ;;
  esac
  run_id=${project_name#"$canonical_prefix"}
  printf '%s\n' "$run_id" \
    | grep -Eq '^[0-9]{8}t[0-9]{6}z-[0-9]+-[0-9a-f]{8}$' \
    || refuse_project
  test "$project_name" != "thesistrace-dev" || refuse_project
}

validate_cleanup_target() {
  validate_test_project
  target_metadata="$state_root/$run_id/run.txt"
  if [ ! -f "$target_metadata" ] \
    || ! grep -Fqx "project_name=$project_name" "$target_metadata"; then
    echo "refusing Test cleanup without matching run metadata: $project_name" >&2
    exit 2
  fi
}

compose() {
  validate_test_project
  if [ "${command:-}" = image-smoke ] \
    || { [ "${command:-}" = benchmark ] && [ "${use_image_overlay:-false}" = true ]; }; then
    COMPOSE_ANSI=never COMPOSE_PROGRESS=plain \
      THESISTRACE_TEST_BUCKET="$bucket_name" \
      THESISTRACE_TEST_DATA_MOUNT="$data_mount" \
      THESISTRACE_TEST_RUN_ROOT="$run_root" \
      THESISTRACE_TEST_EVIDENCE_DIR="$evidence_dir" \
      docker compose \
      --project-name "$project_name" \
      --file "$base_file" \
      --file "$test_file" \
      --file "$image_smoke_file" \
      "$@"
  else
    COMPOSE_ANSI=never COMPOSE_PROGRESS=plain \
      THESISTRACE_TEST_BUCKET="$bucket_name" \
      THESISTRACE_TEST_DATA_MOUNT="$data_mount" \
      docker compose \
      --project-name "$project_name" \
      --file "$base_file" \
      --file "$test_file" \
      "$@"
  fi
}

runtime_image_name() {
  image_service=$1
  printf '%s-%s\n' "$project_name" "$image_service"
}

build_runtime_images() {
  compose build initialize web
  built_backend_image=$(runtime_image_name initialize)
  docker image tag "$built_backend_image" "$(runtime_image_name api)"
  docker image tag "$built_backend_image" "$(runtime_image_name research-worker)"
  docker image tag "$built_backend_image" "$(runtime_image_name batch-research-worker)"
  docker image tag "$built_backend_image" "$(runtime_image_name tracking-worker)"
}

mapped_port() {
  service=$1
  container_port=$2
  address=$(compose port "$service" "$container_port")
  port=${address##*:}
  case "$port" in
    '' | *[!0-9]*)
      echo "could not resolve $service port from: $address" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$port"
}

run_with_environment() {
  THESISTRACE_DATABASE_URL="postgresql://thesistrace:thesistrace-test@127.0.0.1:$postgres_port/thesistrace" \
  THESISTRACE_S3_ENDPOINT_URL="http://127.0.0.1:$s3_port" \
  THESISTRACE_S3_ACCESS_KEY_ID=rustfsadmin \
  THESISTRACE_S3_SECRET_ACCESS_KEY=rustfsadmin \
  THESISTRACE_S3_BUCKET="$bucket_name" \
  THESISTRACE_S3_REGION=us-east-1 \
  THESISTRACE_DATA_MOUNT="$data_mount" \
  THESISTRACE_TEST_PROJECT_NAME="$project_name" \
    "$@"
}

run_playwright() {
  THESISTRACE_TEST_WEB_ORIGIN="http://127.0.0.1:$web_port" \
  THESISTRACE_TEST_EVIDENCE_DIR="$evidence_dir" \
  THESISTRACE_TEST_PROJECT_NAME="$project_name" \
  THESISTRACE_DATABASE_URL="postgresql://thesistrace:thesistrace-test@127.0.0.1:$postgres_port/thesistrace" \
  THESISTRACE_S3_ENDPOINT_URL="http://127.0.0.1:$s3_port" \
  THESISTRACE_S3_ACCESS_KEY_ID=rustfsadmin \
  THESISTRACE_S3_SECRET_ACCESS_KEY=rustfsadmin \
  THESISTRACE_S3_BUCKET="$bucket_name" \
  THESISTRACE_S3_REGION=us-east-1 \
  THESISTRACE_DATA_MOUNT="$data_mount" \
    "$@"
}

capture_evidence() {
  mkdir -p "$evidence_dir"
  compose ps --all >"$evidence_dir/compose-ps.txt" 2>&1 || true
  compose logs --no-color --timestamps >"$evidence_dir/compose-logs.txt" 2>&1 || true
  compose ps --all --quiet | while IFS= read -r container_id; do
    test -n "$container_id" || continue
    docker inspect --format \
      'id={{.Id}} name={{.Name}} image={{.Image}} status={{.State.Status}} running={{.State.Running}} exit_code={{.State.ExitCode}} oom_killed={{.State.OOMKilled}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} log_driver={{.HostConfig.LogConfig.Type}} log_max_size={{index .HostConfig.LogConfig.Config "max-size"}} log_max_file={{index .HostConfig.LogConfig.Config "max-file"}}' \
      "$container_id" || true
  done >"$evidence_dir/container-inspect.txt" 2>&1
}

capture_worker_log_evidence() {
  worker_log="$evidence_dir/worker-events.jsonl"
  compose logs --no-color research-worker batch-research-worker tracking-worker >"$worker_log"
}

capture_api_log_evidence() {
  api_log="$evidence_dir/api-events.jsonl"
  compose logs --no-color api >"$api_log"
}

scan_secret_canaries() {
  scan_result="$evidence_dir/secret-canary-scan.txt"
  : >"$scan_result"
  for canary in \
    observability-access-canary \
    observability-secret-canary \
    observability-request-canary; do
    if grep -R -F -q -- "$canary" "$evidence_dir"; then
      printf 'failed\n' >"$scan_result"
      return 1
    fi
  done
  printf 'passed\n' >"$scan_result"
}

verify_image_health() {
  suffix=$1
  compose run --rm --no-deps -T \
    -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
    -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
    -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
    initialize python /smoke/production_image_smoke.py health \
    >"$evidence_dir/health-$suffix.json" \
    2>"$evidence_dir/health-$suffix.stderr.log"
}

verify_service_readiness_outage() {
  service=$1
  dependency=$2
  outage_status=0
  recovery_status=0
  compose stop "$service" >/dev/null
  compose run --rm --no-deps -T \
    -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
    -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
    -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
    -e THESISTRACE_TEST_UNAVAILABLE_DEPENDENCY="$dependency" \
    initialize python /smoke/production_image_smoke.py readiness-outage \
    >"$evidence_dir/readiness-$dependency-unavailable.json" \
    2>"$evidence_dir/readiness-$dependency-unavailable.stderr.log" \
    || outage_status=$?
  compose logs --no-color "$service" \
    >"$evidence_dir/stopped-$service.log" 2>&1 || true
  test -s "$evidence_dir/stopped-$service.log" || outage_status=1
  compose up --detach --no-build --wait --wait-timeout 120 "$service" \
    || recovery_status=$?
  if [ "$recovery_status" -eq 0 ]; then
    verify_image_health "$dependency-recovered" || recovery_status=$?
  fi
  if [ "$outage_status" -ne 0 ]; then
    return "$outage_status"
  fi
  return "$recovery_status"
}

verify_dataset_readiness_outage() {
  unavailable_mount="$run_root/canonical-data-unavailable"
  outage_status=0
  recovery_status=0
  mv "$data_mount" "$unavailable_mount"
  compose run --rm --no-deps -T \
    -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
    -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
    -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
    -e THESISTRACE_TEST_UNAVAILABLE_DEPENDENCY=dataset_store \
    initialize python /smoke/production_image_smoke.py readiness-outage \
    >"$evidence_dir/readiness-dataset_store-unavailable.json" \
    2>"$evidence_dir/readiness-dataset_store-unavailable.stderr.log" \
    || outage_status=$?
  mv "$unavailable_mount" "$data_mount" || recovery_status=$?
  if [ "$recovery_status" -eq 0 ]; then
    verify_image_health dataset_store-recovered || recovery_status=$?
  fi
  if [ "$outage_status" -ne 0 ]; then
    return "$outage_status"
  fi
  return "$recovery_status"
}

verify_worker_capacity_rejection() {
  for role in research batch-research tracking; do
    if [ "$role" = batch-research ]; then
      service=batch-research-worker
    else
      service="${role}-worker"
    fi
    stdout="$evidence_dir/${role}-worker-cpu-capacity.stdout.log"
    stderr="$evidence_dir/${role}-worker-cpu-capacity.stderr.log"
    if compose run --rm --no-deps -T "$service" \
      thesistrace-core-worker --role "$role" --once --cpu-count 3 \
      >"$stdout" 2>"$stderr"; then
      echo "$role Worker accepted a CPU declaration above its cgroup limit" >&2
      return 1
    fi
    grep -F '"event":"worker_startup_failed"' "$stderr" >/dev/null
    grep -F '"failure_code":"WORKER_CAPACITY_INVALID"' "$stderr" >/dev/null

    stdout="$evidence_dir/${role}-worker-memory-capacity.stdout.log"
    stderr="$evidence_dir/${role}-worker-memory-capacity.stderr.log"
    if compose run --rm --no-deps -T "$service" \
      thesistrace-core-worker --role "$role" --once \
      --memory-bytes 3221225472 \
      >"$stdout" 2>"$stderr"; then
      echo "$role Worker accepted a memory declaration above its cgroup limit" >&2
      return 1
    fi
    grep -F '"event":"worker_startup_failed"' "$stderr" >/dev/null
    grep -F '"failure_code":"WORKER_CAPACITY_INVALID"' "$stderr" >/dev/null
  done
}

verify_research_child_cgroup_oom_detection() {
  backend_image=$(runtime_image_name initialize)
  output="$evidence_dir/research-child-cgroup-oom.json"
  docker run --rm \
    --memory 201326592 \
    --memory-swap 201326592 \
    --entrypoint python \
    "$backend_image" -c '
import json
import subprocess
import sys
from pathlib import Path
from types import SimpleNamespace

from thesistrace.research_run.execution import (
    ResearchExecutionResourceExhausted,
    SupervisedResearchExecution,
)
from thesistrace.research_run.supervised_child import SupervisedChildTransport

def oom_kill_count():
    for path in (
        Path("/sys/fs/cgroup/memory.events.local"),
        Path("/sys/fs/cgroup/memory.events"),
    ):
        if not path.exists():
            continue
        values = dict(line.split(maxsplit=1) for line in path.read_text().splitlines())
        if "oom_kill" in values:
            return int(values["oom_kill"])
    return None

before = oom_kill_count()
if before is None:
    raise SystemExit("cgroup v2 oom_kill evidence is unavailable")
child = subprocess.Popen(
    [
        sys.executable,
        "-c",
        "values=[]\nwhile True: values.append(bytearray(16 * 1024 * 1024))",
    ],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
)
events = []
execution = SupervisedResearchExecution(
    SupervisedChildTransport(child, before),
    SimpleNamespace(
        run_id="image-smoke-oom",
        attempt_id="attempt-1",
        immutable_input=SimpleNamespace(research_kind="factor_evaluation"),
    ),
    {"final": False},
    events.append,
    1536 * 1024 * 1024,
)
classified = False
try:
    execution.advance(cancel_requested=lambda: False)
except ResearchExecutionResourceExhausted:
    classified = True
finally:
    execution.close()
after = oom_kill_count()
if not classified:
    raise SystemExit(
        f"child OOM was not classified: returncode={child.returncode}, "
        f"before={before}, after={after}"
    )
if child.poll() is None:
    raise SystemExit("OOM child was not reaped by the production supervisor")
if not any(event["event"] == "research_execution_child_exited" for event in events):
    raise SystemExit("production supervisor emitted no child-exit evidence")
print(json.dumps({
    "after_oom_kill": after,
    "before_oom_kill": before,
    "classified": True,
    "child_returncode": child.returncode,
    "child_exit_emitted": True,
}, sort_keys=True, separators=(",", ":")))
' >"$output"
  grep -F '"classified":true' "$output" >/dev/null
  grep -F '"child_returncode":-9' "$output" >/dev/null
}

reset_product_state() {
  compose stop api research-worker batch-research-worker tracking-worker postgres rustfs >/dev/null 2>&1 || true
  compose rm --force api research-worker batch-research-worker tracking-worker initialize postgres rustfs \
    >/dev/null 2>&1 || true
  "$repo_root/scripts/product-state-volumes" reset "$project_name"
  compose up --detach --no-build --wait --wait-timeout 300 postgres rustfs initialize
  compose wait initialize
}

cleanup_project() {
  validate_cleanup_target
  compose_status=0
  compose down --volumes --remove-orphans || compose_status=$?
  mount_status=0
  rm -rf -- "$state_root/$run_id/canonical-data" || mount_status=$?
  if [ "$compose_status" -ne 0 ]; then
    return "$compose_status"
  fi
  return "$mount_status"
}

handle_signal() {
  requested_status=$1
  interrupted_status=$requested_status
  if [ -n "$active_pid" ]; then
    kill -TERM "-$active_pid" 2>/dev/null \
      || kill -TERM "$active_pid" 2>/dev/null \
      || true
  else
    exit "$requested_status"
  fi
}

run_managed() {
  active_pid=
  set -m
  (
    trap '' INT
    "$@"
  ) &
  active_pid=$!
  set +m

  set +e
  wait "$active_pid" 2>/dev/null
  child_status=$?
  set -e
  active_pid=
  if [ -n "$interrupted_status" ]; then
    return "$interrupted_status"
  fi
  return "$child_status"
}

run_phase() {
  phase_name=$1
  shift
  phase_started=$(date +%s)
  if run_managed "$@"; then
    phase_status=0
  else
    phase_status=$?
  fi
  phase_finished=$(date +%s)
  phase_seconds=$((phase_finished - phase_started))
  printf 'phase=%s seconds=%s status=%s\n' \
    "$phase_name" "$phase_seconds" "$phase_status" >>"$run_metadata"
  return "$phase_status"
}

finish() {
  status=$?
  trap - EXIT
  trap '' INT TERM
  set +e
  if [ "$status" -ne 0 ]; then
    capture_evidence
    if scan_secret_canaries; then
      failure_canary_scan_status=0
    else
      failure_canary_scan_status=1
      echo "secret canary detected in failure evidence" >&2
    fi
    printf 'failure_canary_scan_status=%s\n' \
      "$failure_canary_scan_status" >>"$run_metadata"
  fi
  if [ "$status" -ne 0 ] && [ "$keep_environment" = true ]; then
    echo "preserved failing Test project $project_name" >&2
    printf 'cleanup_status=kept\n' >>"$run_metadata"
  else
    cleanup_project
    cleanup_status=$?
    printf 'cleanup_status=%s\n' "$cleanup_status" >>"$run_metadata"
    if [ "$cleanup_status" -ne 0 ]; then
      echo "cleanup failed for Test project $project_name (status $cleanup_status)" >&2
    fi
    if [ "$status" -eq 0 ] && [ "$cleanup_status" -ne 0 ]; then
      status=$cleanup_status
    fi
  fi
  printf 'status=%s\n' "$status" >>"$run_metadata"
  exit "$status"
}

command=${1:-}
case "$command" in
  identity)
    printf '%s%s\n' "$canonical_prefix" "$(new_run_id)"
    exit 0
    ;;
  cleanup)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    cleanup_project
    exit 0
    ;;
  stop-postgres | restart-postgres | stop-rustfs | restart-rustfs)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    validate_cleanup_target
    service=postgres
    if [ "$command" = stop-rustfs ] || [ "$command" = restart-rustfs ]; then
      service=rustfs
    fi
    if [ "$command" = stop-postgres ] || [ "$command" = stop-rustfs ]; then
      compose stop "$service" >&2
      exit 0
    fi
    compose restart "$service" >&2
    readiness_attempt=0
    until {
      if [ "$service" = postgres ]; then
        compose exec -T postgres pg_isready -U thesistrace -d thesistrace >/dev/null 2>&1
      else
        compose exec -T rustfs sh -c \
          'curl -fsS http://127.0.0.1:9000/health' >/dev/null 2>&1
      fi
    }; do
      readiness_attempt=$((readiness_attempt + 1))
      if [ "$readiness_attempt" -ge 60 ]; then
        echo "$service did not become ready after restart" >&2
        exit 1
      fi
      sleep 1
    done
    if [ "$service" = postgres ]; then
      mapped_port postgres 5432
    else
      mapped_port rustfs 9000
    fi
    exit 0
    ;;
  integration | integration-batch-cancel | benchmark | e2e | image-smoke) ;;
  *)
    echo "usage: $0 {identity|cleanup|stop-postgres|restart-postgres|stop-rustfs|restart-rustfs|integration|integration-batch-cancel|benchmark|e2e|image-smoke [--keep-environment]}" >&2
    exit 2
    ;;
esac
shift

keep_environment=false
case "${1:-}" in
  '') ;;
  --keep-environment)
    keep_environment=true
    shift
    ;;
  *)
    echo "unknown $command option: $1" >&2
    exit 2
    ;;
esac
test "$#" -eq 0 || {
  echo "$command accepts only --keep-environment" >&2
  exit 2
}

run_id=$(new_run_id)
project_name="$canonical_prefix$run_id"
bucket_name="$canonical_prefix$run_id"
run_root="$state_root/$run_id"
data_mount="$run_root/canonical-data"
evidence_dir="$run_root/evidence"
pytest_report="$evidence_dir/pytest.xml"
database_restart_report="$evidence_dir/pytest-database-restart.xml"
dependency_restart_report="$evidence_dir/pytest-dependency-restart.xml"
run_metadata="$run_root/run.txt"
validate_test_project
mkdir -p "$evidence_dir" "$data_mount" "$data_mount/.batch-attempts"
git_revision=$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf unknown)
git_worktree_dirty=false
if [ -n "$(git -C "$repo_root" status --short 2>/dev/null)" ]; then
  git_worktree_dirty=true
fi
printf 'run_id=%s\nproject_name=%s\ngit_revision=%s\ngit_worktree_dirty=%s\n' \
  "$run_id" "$project_name" "$git_revision" "$git_worktree_dirty" >"$run_metadata"
printf 'test_kind=%s\n' "$command" >>"$run_metadata"
echo "Test run: $run_id"
echo "Compose project: $project_name"

trap finish EXIT
active_pid=
interrupted_status=
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

compose config --quiet
case "$command" in
  integration-batch-cancel)
    run_phase integration-batch-cancel-infrastructure compose up --detach \
      --wait --wait-timeout 300 postgres rustfs
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    printf 'postgres_port=%s\ns3_port=%s\n' "$postgres_port" "$s3_port" >>"$run_metadata"
    run_phase integration-batch-cancel-initialization \
      run_with_environment uv run thesistrace-initialize
    run_phase integration-batch-cancel-pytest run_with_environment uv run pytest -q \
      tests/acceptance/test_core_research_batch_cancel.py \
      -m "not database_restart and not dependency_restart" --junitxml="$pytest_report"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-batch-cancel-postgres-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_cancel.py::test_cancel_check_fails_closed_during_postgres_outage_and_reconciles_after_restart \
      --junitxml="$database_restart_report"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-batch-cancel-rustfs-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_cancel.py::test_cancel_is_terminal_while_object_cleanup_retries_after_rustfs_restart \
      --junitxml="$dependency_restart_report"
    ;;
  benchmark)
    use_image_overlay=true
    run_phase benchmark-images build_runtime_images
    run_phase benchmark-infrastructure compose up --detach --no-build \
      --wait --wait-timeout 300 postgres rustfs initialize
    run_phase benchmark-initialization compose wait initialize
    qualification_dir="$evidence_dir/long-research"
    mkdir -p "$qualification_dir"
    run_phase benchmark-prepare compose run --rm --no-deps -T initialize \
      python /qualification/long_research_qualification.py prepare \
      --output /smoke-evidence/long-research/preparation.json
    for research_kind in factor_evaluation strategy_backtest; do
      sample_index=0
      while [ "$sample_index" -lt 5 ]; do
        run_phase "benchmark-$research_kind-cold-$sample_index-product-state-reset" \
          reset_product_state
        run_phase "benchmark-$research_kind-cold-$sample_index-api" \
          compose up --detach --no-build --wait --wait-timeout 120 api
        run_phase "benchmark-$research_kind-cold-$sample_index" \
          compose run --rm --no-deps -T \
          -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
          research-worker python /qualification/long_research_qualification.py sample \
          --research-kind "$research_kind" \
          --phase cold --index "$sample_index" --require-fresh-product-state \
          --log "/qualification-evidence/long-research/$research_kind-cold-$sample_index.log" \
          --output "/qualification-evidence/long-research/$research_kind-cold-$sample_index.json"
        sample_index=$((sample_index + 1))
      done
    done
    run_phase benchmark-warm-preload-product-state-reset reset_product_state
    run_phase benchmark-warm-preload compose run --rm --no-deps -T \
      research-worker python /qualification/long_research_qualification.py preload \
      --output /qualification-evidence/long-research/preload.json
    for research_kind in factor_evaluation strategy_backtest; do
      sample_index=0
      while [ "$sample_index" -lt 5 ]; do
        run_phase "benchmark-$research_kind-warm-$sample_index-product-state-reset" \
          reset_product_state
        run_phase "benchmark-$research_kind-warm-$sample_index-api" \
          compose up --detach --no-build --wait --wait-timeout 120 api
        run_phase "benchmark-$research_kind-warm-$sample_index" \
          compose run --rm --no-deps -T \
          -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
          research-worker python /qualification/long_research_qualification.py sample \
          --research-kind "$research_kind" \
          --phase warm --index "$sample_index" --require-fresh-product-state \
          --log "/qualification-evidence/long-research/$research_kind-warm-$sample_index.log" \
          --output "/qualification-evidence/long-research/$research_kind-warm-$sample_index.json"
        sample_index=$((sample_index + 1))
      done
    done
    for research_kind in factor_evaluation strategy_backtest; do
      run_phase "benchmark-$research_kind-cancellation-product-state-reset" \
        reset_product_state
      run_phase "benchmark-$research_kind-cancellation-api" \
        compose up --detach --no-build --wait --wait-timeout 120 api
      run_phase "benchmark-$research_kind-cancellation" compose run --rm --no-deps -T \
        -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
        research-worker python /qualification/long_research_qualification.py cancel \
        --research-kind "$research_kind" \
        --log "/qualification-evidence/long-research/$research_kind-cancellation.log" \
        --output "/qualification-evidence/long-research/$research_kind-cancellation.json"
    done
    backend_image=$(runtime_image_name initialize)
    image_revision=$(docker image inspect "$backend_image" --format '{{.Id}}')
    run_phase benchmark-qualification compose run --rm --no-deps -T initialize \
      python /qualification/long_research_qualification.py assemble \
      --samples /smoke-evidence/long-research \
      --image-revision "$image_revision" \
      --output /smoke-evidence/long-research-qualification.json
    compose logs --no-color api >"$evidence_dir/long-research/api.log"
    compose ps --all >"$evidence_dir/long-research/compose-ps.txt"
    compose images --format json >"$evidence_dir/long-research/images.jsonl"
    ;;
  integration)
    run_phase integration-infrastructure compose up --detach \
      --wait --wait-timeout 300 postgres rustfs
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    printf 'postgres_port=%s\ns3_port=%s\n' "$postgres_port" "$s3_port" >>"$run_metadata"
    run_phase integration-initialization run_with_environment uv run thesistrace-initialize
    run_phase integration-pytest run_with_environment uv run pytest -q \
      tests/integration tests/acceptance \
      -m "not database_restart and not dependency_restart" \
      --junitxml="$pytest_report"
    postgres_port=$(mapped_port postgres 5432)
    run_phase integration-database-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 \
      uv run pytest -q tests/acceptance/test_core_direct_research_run_admission.py \
      -m database_restart --junitxml="$database_restart_report"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-rustfs-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_factor_recovery.py::test_real_rustfs_loss_retries_the_complete_factor_task \
      --junitxml="$dependency_restart_report"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-rustfs-strategy-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_strategy_execution.py::test_real_rustfs_loss_retries_shared_strategy_prerequisite \
      --junitxml="$evidence_dir/pytest-rustfs-strategy-restart.xml"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-rustfs-batch-cancel-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_cancel.py::test_cancel_is_terminal_while_object_cleanup_retries_after_rustfs_restart \
      --junitxml="$evidence_dir/pytest-rustfs-batch-cancel-restart.xml"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-postgres-batch-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_factor_recovery.py::test_real_postgres_loss_recovers_after_child_exit \
      --junitxml="$evidence_dir/pytest-postgres-batch-restart.xml"
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase integration-postgres-strategy-restart run_with_environment env \
      THESISTRACE_DATABASE_RESTART_PHASE=1 uv run pytest -q \
      tests/acceptance/test_core_research_batch_strategy_execution.py::test_real_postgres_loss_reuses_acknowledged_private_artifact \
      --junitxml="$evidence_dir/pytest-postgres-strategy-restart.xml"
    ;;
  e2e)
    run_phase e2e-images build_runtime_images
    run_phase e2e-infrastructure compose up --detach --no-build \
      --wait --wait-timeout 300 \
      postgres rustfs initialize
    run_phase e2e-initialization compose wait initialize
    postgres_port=$(mapped_port postgres 5432)
    s3_port=$(mapped_port rustfs 9000)
    run_phase e2e-operator-bootstrap run_with_environment uv run \
      thesistrace-data-operator bootstrap \
      --idempotency-key financial-release-bootstrap \
      --as-of 2026-08-05T18:00:00+08:00 \
      --start-date 2010-01-04 \
      --replay tests/fixtures/tushare-financial-product-replay.json
    run_phase e2e-prepare-data run_with_environment uv run python \
      tests/browser/prepare_current_data.py
    run_phase e2e-application compose up --detach --no-build \
      --wait --wait-timeout 300 \
      api research-worker batch-research-worker tracking-worker web
    api_port=$(mapped_port api 8100)
    web_port=$(mapped_port web 5173)
    printf 'postgres_port=%s\ns3_port=%s\napi_port=%s\nweb_port=%s\n' \
      "$postgres_port" "$s3_port" "$api_port" "$web_port" >>"$run_metadata"
    run_phase e2e-playwright run_playwright bun run --cwd web test:e2e
    ;;
  image-smoke)
    smoke_state=/smoke-evidence/image-smoke-state.json
    run_phase image-smoke-images build_runtime_images
    run_phase image-smoke-worker-capacity-rejection verify_worker_capacity_rejection
    run_phase image-smoke-research-child-cgroup-oom \
      verify_research_child_cgroup_oom_detection
