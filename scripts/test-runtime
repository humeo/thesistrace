      --wait --wait-timeout 120 rustfs
    run_phase image-smoke-after compose run --rm --no-deps -T \
      -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
      -e THESISTRACE_TEST_SMOKE_STATE="$smoke_state" \
      initialize python /smoke/production_image_smoke.py after \
      >"$evidence_dir/smoke-after.json" \
      2>"$evidence_dir/smoke-after.stderr.log"
    run_phase image-smoke-reset-worker-stop compose stop research-worker batch-research-worker
