compose_run() {
  compose run --rm --no-deps -T --interactive=false "$@"
}

base_compose_run() {
  base_compose run --rm --no-deps -T --interactive=false "$@"
}

runtime_image_name() {
  image_service=$1
  printf '%s-%s\n' "$project_name" "$image_service"
}

cleanup_runtime_images() {
  runtime_images_status=0
  for image_service in \
    api research-worker batch-research-worker tracking-worker data-operator-worker \
    initialize agent auth web; do
    image_name=$(runtime_image_name "$image_service")
    if docker image inspect "$image_name" >/dev/null 2>&1; then
      docker image rm "$image_name" >/dev/null || runtime_images_status=$?
    fi
  done
  return "$runtime_images_status"
}

build_runtime_images() {
  compose build initialize auth-initialize agent web || return $?
  built_backend_image=$(runtime_image_name initialize)
  docker image tag "$built_backend_image" "$(runtime_image_name api)" || return $?
  docker image tag "$built_backend_image" "$(runtime_image_name research-worker)" \
    || return $?
  docker image tag "$built_backend_image" "$(runtime_image_name batch-research-worker)" \
    || return $?
  docker image tag "$built_backend_image" "$(runtime_image_name tracking-worker)" \
    || return $?
  docker image tag "$built_backend_image" "$(runtime_image_name data-operator-worker)" \
    || return $?
}

mapped_port() {
  service=$1
  container_port=$2
  address=$(compose port "$service" "$container_port")
  port=${address##*:}
  case "$port" in
    '' | *[!0-9]*)
      echo "could not resolve $service port from: $address" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$port"
}

