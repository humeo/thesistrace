    run_phase image-smoke-publish-transient-target compose run --rm --no-deps -T \
      initialize python /smoke/browser/prepare_image_smoke_data.py lagged \
      >"$evidence_dir/transient-target.json" \
      2>"$evidence_dir/transient-target.stderr.log"
    run_phase image-smoke-transient-failed compose run --rm --no-deps -T \
      -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:5173 \
