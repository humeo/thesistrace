}

capture_stopped_api_state() {
  container_id=$(compose ps --all --quiet api)
  test -n "$container_id" || return 1
  docker inspect --format \
    '{"status":"{{.State.Status}}","exit_code":{{.State.ExitCode}},"oom_killed":{{.State.OOMKilled}}}' \
    "$container_id" >"$evidence_dir/mcp-api-stopped.json"
}

verify_service_readiness_outage() {
  service=$1
  dependency=$2
  outage_status=0
  recovery_status=0
  compose stop "$service" >/dev/null
  compose_run \
    -e THESISTRACE_TEST_API_ORIGIN=http://api:8100 \
    -e THESISTRACE_TEST_WEB_ORIGIN=http://web:$caddy_port \
    -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
    -e THESISTRACE_TEST_UNAVAILABLE_DEPENDENCY="$dependency" \
    initialize python /smoke/production_image_smoke.py readiness-outage \
    >"$evidence_dir/readiness-$dependency-unavailable.json" \
    2>"$evidence_dir/readiness-$dependency-unavailable.stderr.log" \
    || outage_status=$?
  compose logs --no-color "$service" \
    >"$evidence_dir/stopped-$service.log" 2>&1 || true
  test -s "$evidence_dir/stopped-$service.log" || outage_status=1
  compose up --detach --no-build --wait --wait-timeout 120 "$service" \
    || recovery_status=$?
  if [ "$recovery_status" -eq 0 ]; then
    verify_image_health "$dependency-recovered" || recovery_status=$?
  fi
  if [ "$outage_status" -ne 0 ]; then
    return "$outage_status"
  fi
  return "$recovery_status"
}

verify_dataset_readiness_outage() {
  outage_container="dataset-store-outage-$run_id"
  outage_parent="$run_root/dataset-store-outage"
  outage_root="$outage_parent/current"
  outage_status=0
  recovery_status=0
  mkdir -p "$outage_parent"
  ln -s ../canonical-data "$outage_root"
  compose_run --detach \
    --name "$outage_container" \
    --volume "$outage_parent:/smoke-data/dataset-store-outage:ro" \
    -e THESISTRACE_DATA_MOUNT=/smoke-data/dataset-store-outage/current \
    api >/dev/null || outage_status=$?
  if [ "$outage_status" -eq 0 ]; then
    compose_run \
      -e THESISTRACE_TEST_API_ORIGIN="http://$outage_container:8100" \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:$caddy_port \
      -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
      initialize python /smoke/production_image_smoke.py health \
      >"$evidence_dir/readiness-dataset_store-before-outage.json" \
      2>"$evidence_dir/readiness-dataset_store-before-outage.stderr.log" \
      || outage_status=$?
  fi
  if [ "$outage_status" -eq 0 ]; then
    unlink "$outage_root" || outage_status=$?
  fi
  if [ "$outage_status" -eq 0 ]; then
    compose_run \
      -e THESISTRACE_TEST_API_ORIGIN="http://$outage_container:8100" \
      -e THESISTRACE_TEST_WEB_ORIGIN=http://web:$caddy_port \
      -e THESISTRACE_TEST_SMOKE_STATE=/smoke-evidence/image-smoke-state.json \
      -e THESISTRACE_TEST_UNAVAILABLE_DEPENDENCY=dataset_store \
      initialize python /smoke/production_image_smoke.py readiness-outage \
      >"$evidence_dir/readiness-dataset_store-unavailable.json" \
      2>"$evidence_dir/readiness-dataset_store-unavailable.stderr.log" \
      || outage_status=$?
  fi
  docker logs "$outage_container" \
    >"$evidence_dir/readiness-dataset_store-api.log" 2>&1 || true
  docker stop "$outage_container" >/dev/null || recovery_status=$?
  if [ "$recovery_status" -eq 0 ]; then
    verify_image_health dataset_store-recovered || recovery_status=$?
  fi
  if [ "$outage_status" -ne 0 ]; then
    return "$outage_status"
  fi
  return "$recovery_status"
}

verify_worker_capacity_rejection() {
  for role in research batch-research tracking; do
    if [ "$role" = batch-research ]; then
      service=batch-research-worker
    else
      service="${role}-worker"
    fi
    stdout="$evidence_dir/${role}-worker-cpu-capacity.stdout.log"
    stderr="$evidence_dir/${role}-worker-cpu-capacity.stderr.log"
    if compose_run "$service" \
      thesistrace-core-worker --role "$role" --once --cpu-count 3 \
      >"$stdout" 2>"$stderr"; then
      echo "$role Worker accepted a CPU declaration above its cgroup limit" >&2
      return 1
    fi
    grep -F '"event":"worker_startup_failed"' "$stderr" >/dev/null
    grep -F '"failure_code":"WORKER_CAPACITY_INVALID"' "$stderr" >/dev/null

    stdout="$evidence_dir/${role}-worker-memory-capacity.stdout.log"
    stderr="$evidence_dir/${role}-worker-memory-capacity.stderr.log"
    if compose_run "$service" \
      thesistrace-core-worker --role "$role" --once \
      --memory-bytes 3221225472 \
      >"$stdout" 2>"$stderr"; then
      echo "$role Worker accepted a memory declaration above its cgroup limit" >&2
      return 1
    fi
    grep -F '"event":"worker_startup_failed"' "$stderr" >/dev/null
    grep -F '"failure_code":"WORKER_CAPACITY_INVALID"' "$stderr" >/dev/null
  done
}

verify_tushare_secret_scope() {
  for service in \
    postgres rustfs initialize auth-initialize auth api research-worker \
    batch-research-worker tracking-worker web; do
    container_id="$project_name-$service-1"
    container_environment=$(docker inspect \
      --format '{{range .Config.Env}}{{println .}}{{end}}' "$container_id") \
      || return 1
    if printf '%s\n' "$container_environment" \
      | grep -q '^THESISTRACE_TUSHARE_TOKEN='; then
      echo "Tushare Secret escaped into $service" >&2
      return 1
    fi
  done
  worker_id="$project_name-data-operator-worker-1"
  worker_environment=$(docker inspect \
    --format '{{range .Config.Env}}{{println .}}{{end}}' "$worker_id") \
    || return 1
  printf '%s\n' "$worker_environment" \
    | grep -q '^THESISTRACE_TUSHARE_TOKEN=' \
    || return 1
  browser_html=$(curl --fail --silent --show-error "$public_origin/data") \
    || return 1
  if printf '%s' "$browser_html" | grep -Fq "$tushare_test_token"; then
    echo "Tushare Secret escaped into browser state" >&2
    return 1
  fi
}

verify_data_operator_worker_secret_rejection() {
  for scenario in missing placeholder; do
    case "$scenario" in
      missing) token= ;;
      placeholder) token=placeholder-image-smoke-token ;;
    esac
    stdout="$evidence_dir/data-operator-worker-$scenario-token.stdout.json"
    stderr="$evidence_dir/data-operator-worker-$scenario-token.stderr.log"
    if compose_run \
      -e "THESISTRACE_TUSHARE_TOKEN=$token" \
      data-operator-worker thesistrace-data-operator worker \
      >"$stdout" 2>"$stderr"; then
      echo "Data Operator Worker accepted a $scenario Tushare credential" >&2
      return 1
    fi
    if ! grep -E '"code"[[:space:]]*:[[:space:]]*"WORKER_TUSHARE_TOKEN_INVALID"' \
      "$stdout" "$stderr" >/dev/null; then
      echo "Data Operator Worker did not report the $scenario credential failure" >&2
      return 1
    fi
  done
  verify_image_health data-operator-secret-rejected
}

verify_single_data_operator_worker() {
  worker_ids=$(compose ps --status running --quiet data-operator-worker)
  worker_count=$(printf '%s\n' "$worker_ids" | sed '/^$/d' | wc -l | tr -d ' ')
  test "$worker_count" = 1 || {
    echo "expected exactly one running Data Operator Worker, found $worker_count" >&2
    return 1
  }
  worker_id=$(printf '%s\n' "$worker_ids" | sed -n '1p')
  docker inspect --format '{{json .Config.Cmd}}' "$worker_id" \
    >"$evidence_dir/data-operator-worker-command.json"
  grep -F 'thesistrace-data-operator' \
    "$evidence_dir/data-operator-worker-command.json" >/dev/null
  grep -F 'worker' "$evidence_dir/data-operator-worker-command.json" >/dev/null
  if grep -F -- '--once' "$evidence_dir/data-operator-worker-command.json" >/dev/null; then
    echo "Production Data Operator Worker is running as a one-shot command" >&2
    return 1
  fi
}

verify_research_child_cgroup_oom_detection() {
  backend_image=$(runtime_image_name initialize)
  output="$evidence_dir/research-child-cgroup-oom.json"
  docker run --rm \
    --memory 201326592 \
    --memory-swap 201326592 \
    --entrypoint python \
    "$backend_image" -c '
import json
import subprocess
import sys
from pathlib import Path
from types import SimpleNamespace

from thesistrace.research_run.execution import (
    ResearchExecutionResourceExhausted,
    SupervisedResearchExecution,
)
from thesistrace.research_run.supervised_child import SupervisedChildTransport

def oom_kill_count():
    for path in (
        Path("/sys/fs/cgroup/memory.events.local"),
        Path("/sys/fs/cgroup/memory.events"),
    ):
        if not path.exists():
            continue
        values = dict(line.split(maxsplit=1) for line in path.read_text().splitlines())
        if "oom_kill" in values:
            return int(values["oom_kill"])
    return None

before = oom_kill_count()
if before is None:
    raise SystemExit("cgroup v2 oom_kill evidence is unavailable")
child = subprocess.Popen(
    [
        sys.executable,
        "-c",
        "values=[]\nwhile True: values.append(bytearray(16 * 1024 * 1024))",
    ],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
)
events = []
execution = SupervisedResearchExecution(
    SupervisedChildTransport(child, before),
    SimpleNamespace(
        run_id="image-smoke-oom",
        attempt_id="attempt-1",
        immutable_input=SimpleNamespace(research_kind="factor_evaluation"),
    ),
    {"final": False},
    events.append,
    1536 * 1024 * 1024,
)
classified = False
try:
    execution.advance(cancel_requested=lambda: False)
except ResearchExecutionResourceExhausted:
    classified = True
finally:
    execution.close()
after = oom_kill_count()
if not classified:
    raise SystemExit(
        f"child OOM was not classified: returncode={child.returncode}, "
        f"before={before}, after={after}"
    )
if child.poll() is None:
    raise SystemExit("OOM child was not reaped by the production supervisor")
if not any(event["event"] == "research_execution_child_exited" for event in events):
    raise SystemExit("production supervisor emitted no child-exit evidence")
print(json.dumps({
    "after_oom_kill": after,
    "before_oom_kill": before,
    "classified": True,
    "child_returncode": child.returncode,
    "child_exit_emitted": True,
}, sort_keys=True, separators=(",", ":")))
' >"$output"
  grep -F '"classified":true' "$output" >/dev/null
  grep -F '"child_returncode":-9' "$output" >/dev/null
}

reset_product_state() {
  compose stop auth auth-fixture-control api research-worker batch-research-worker tracking-worker \
    data-operator-worker postgres rustfs \
    >/dev/null 2>&1 || true
  compose rm --force auth auth-fixture-control auth-initialize api research-worker batch-research-worker \
    tracking-worker data-operator-worker initialize postgres rustfs \
    >/dev/null 2>&1 || true
  "$repo_root/scripts/product-state-volumes" reset "$project_name"
  compose up --detach --no-build --wait --wait-timeout 300 postgres rustfs
  compose up --detach --no-build initialize auth-initialize
  compose wait initialize auth-initialize
}

provision_image_smoke_auth() {
  test -n "$auth_session_file" || return 2
  rm -f -- "$auth_session_file"
  run_with_environment uv run python \
    tests/acceptance/provision_image_smoke_auth.py "$auth_session_file"
}

prepare_benchmark_api() {
  compose up --detach --no-build --wait --wait-timeout 120 auth api
  postgres_port=$(mapped_port postgres 5432)
  s3_port=$(mapped_port rustfs 9000)
  provision_image_smoke_auth
}

cleanup_runtime_secrets() {
  test -n "${secret_dir:-}" || return 0
  if [ -n "${auth_session_file:-}" ]; then
    rm -f -- "$auth_session_file" || return $?
  fi
  if [ -n "${operator_sessions_file:-}" ]; then
    rm -f -- "$operator_sessions_file" || return $?
  fi
  rmdir "$secret_dir"
}

cleanup_project() {
  validate_cleanup_target
  load_test_origin
  compose_status=0
  product_state_status=0
  image_status=0
  if [ "$compose_cleanup_required" = true ]; then
    compose down --volumes --remove-orphans || compose_status=$?
    "$repo_root/scripts/product-state-volumes" erase "$project_name" \
      || product_state_status=$?
    if [ "$compose_status" -eq 0 ]; then
      cleanup_runtime_images || image_status=$?
    fi
  fi
  mount_status=0
  rm -rf -- "$state_root/$run_id/canonical-data" || mount_status=$?
  rm -rf -- "$state_root/$run_id/benchmark-data" || mount_status=$?
  rm -rf -- "$state_root/$run_id/batch-attempt-control" || mount_status=$?
  port_lock_status=0
  if [ "$compose_status" -eq 0 ]; then
    release_test_origin || port_lock_status=$?
  fi
  if [ "$compose_status" -ne 0 ]; then
    return "$compose_status"
  fi
  if [ "$product_state_status" -ne 0 ]; then
    return "$product_state_status"
  fi
  if [ "$image_status" -ne 0 ]; then
    return "$image_status"
  fi
  if [ "$port_lock_status" -ne 0 ]; then
    return "$port_lock_status"
  fi
  return "$mount_status"
}

handle_signal() {
  requested_status=$1
  interrupted_status=$requested_status
  if [ -n "$active_pid" ]; then
    kill -TERM "-$active_pid" 2>/dev/null \
      || kill -TERM "$active_pid" 2>/dev/null \
      || true
  else
    exit "$requested_status"
  fi
}

run_managed() {
  active_pid=
  set -m
  (
    trap '' INT
    "$@" </dev/null
  ) &
  active_pid=$!
  set +m

  set +e
  wait "$active_pid" 2>/dev/null
  child_status=$?
  set -e
  active_pid=
  if [ -n "$interrupted_status" ]; then
    return "$interrupted_status"
  fi
  return "$child_status"
}

run_phase() {
  phase_name=$1
  shift
  phase_started=$(date +%s)
  if run_managed "$@"; then
    phase_status=0
  else
    phase_status=$?
  fi
  phase_finished=$(date +%s)
  phase_seconds=$((phase_finished - phase_started))
  printf 'phase=%s seconds=%s status=%s\n' \
    "$phase_name" "$phase_seconds" "$phase_status" >>"$run_metadata"
  return "$phase_status"
}

require_codex_host() {
  if ! command -v codex >/dev/null 2>&1; then
    echo "real Codex acceptance requires the Codex CLI" >&2
    return 1
  fi
  if ! codex --ask-for-approval never exec --help >/dev/null; then
    echo "real Codex acceptance requires the supported noninteractive CLI contract" >&2
    return 1
  fi
}

verify_codex_evidence() {
  target=$1
  test -s "$target" || return 1
  uv run python -c \
    'import json, pathlib, sys; value=json.loads(pathlib.Path(sys.argv[1]).read_text()); raise SystemExit(0 if isinstance(value, dict) and value.get("status") == "passed" else 1)' \
    "$target" || return 1
}

finish() {
  status=$?
  trap - EXIT
  trap '' INT TERM
  set +e
  secret_cleanup_status=0
  cleanup_runtime_secrets || secret_cleanup_status=$?
  printf 'runtime_secret_cleanup_status=%s\n' \
    "$secret_cleanup_status" >>"$run_metadata"
  if [ "$secret_cleanup_status" -ne 0 ]; then
    echo "runtime secret cleanup failed" >&2
    if [ "$status" -eq 0 ]; then
      status=$secret_cleanup_status
    fi
  fi
  # Scan original logs and diagnostics on success as well as failure. A later
  # redaction protects evidence but must never turn a leak into a passing run.
  capture_evidence
  compose logs --no-color agent >"$evidence_dir/agent-events.jsonl" 2>&1 || true
  capture_worker_log_evidence
  capture_api_log_evidence
  capture_gateway_auth_log_evidence
  if uv run python "$repo_root/tests/sanitize_production_mcp_evidence.py" \
    scan "$evidence_dir" >"$evidence_dir/raw-canary-scan.json"; then
    raw_canary_scan_status=0
  else
    raw_canary_scan_status=1
    echo "content canary detected in original diagnostics; see sanitized categories" >&2
    if [ "$status" -eq 0 ]; then status=1; fi
  fi
  printf 'raw_canary_scan_status=%s\n' "$raw_canary_scan_status" >>"$run_metadata"
  if [ "$status" -ne 0 ]; then
    if sanitize_mcp_failure_evidence; then
      failure_evidence_sanitization_status=0
    else
      failure_evidence_sanitization_status=1
      echo "failed to sanitize MCP failure evidence" >&2
      if discard_unsanitized_failure_evidence; then
        failure_evidence_discard_status=0
      else
        failure_evidence_discard_status=1
        echo "failed to discard unsanitized MCP evidence" >&2
      fi
      printf 'failure_evidence_discard_status=%s\n' \
        "$failure_evidence_discard_status" >>"$run_metadata"
    fi
    printf 'failure_evidence_sanitization_status=%s\n' \
      "$failure_evidence_sanitization_status" >>"$run_metadata"
    if scan_secret_canaries; then
      failure_canary_scan_status=0
    else
      failure_canary_scan_status=1
      echo "secret canary detected in failure evidence" >&2
    fi
    printf 'failure_canary_scan_status=%s\n' \
      "$failure_canary_scan_status" >>"$run_metadata"
  fi
  if [ "$status" -ne 0 ] \
    && [ "$keep_environment" = true ] \
    && [ "$compose_cleanup_required" = true ]; then
    echo "preserved failing Test project $project_name" >&2
    printf 'cleanup_status=kept\n' >>"$run_metadata"
  else
    cleanup_project
    cleanup_status=$?
    printf 'cleanup_status=%s\n' "$cleanup_status" >>"$run_metadata"
    if [ "$cleanup_status" -ne 0 ]; then
      echo "cleanup failed for Test project $project_name (status $cleanup_status)" >&2
    fi
    if [ "$status" -eq 0 ] && [ "$cleanup_status" -ne 0 ]; then
      status=$cleanup_status
    fi
  fi
  printf 'status=%s\n' "$status" >>"$run_metadata"
  exit "$status"
}

command=${1:-}
case "$command" in
  identity)
    printf '%s%s\n' "$canonical_prefix" "$(new_run_id)"
    exit 0
    ;;
  cleanup)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    benchmark_mount="$state_root/$run_id/benchmark-data"
    batch_attempt_control_directory="$state_root/$run_id/batch-attempt-control/.batch-attempts"
    cleanup_project
    exit 0
    ;;
  stop-postgres | restart-postgres | stop-rustfs | restart-rustfs)
    project_name=${THESISTRACE_TEST_PROJECT_NAME-}
    bucket_name=${project_name#"$canonical_prefix"}
    run_id=${project_name#"$canonical_prefix"}
    data_mount="$state_root/$run_id/canonical-data"
    benchmark_mount="$state_root/$run_id/benchmark-data"
    batch_attempt_control_directory="$state_root/$run_id/batch-attempt-control/.batch-attempts"
    validate_cleanup_target
    load_test_origin
    service=postgres
    if [ "$command" = stop-rustfs ] || [ "$command" = restart-rustfs ]; then
      service=rustfs
    fi
    if [ "$command" = stop-postgres ] || [ "$command" = stop-rustfs ]; then
      compose stop "$service" >&2
      exit 0
    fi
    compose restart "$service" >&2
    readiness_attempt=0
    until {
      if [ "$service" = postgres ]; then
        compose exec -T postgres pg_isready -U thesistrace_owner -d thesistrace \
          >/dev/null 2>&1
      else
        compose exec -T rustfs sh -c \
          'curl -fsS http://127.0.0.1:9000/health' >/dev/null 2>&1
      fi
    }; do
      readiness_attempt=$((readiness_attempt + 1))
      if [ "$readiness_attempt" -ge 60 ]; then
        echo "$service did not become ready after restart" >&2
        exit 1
      fi
      sleep 1
    done
    if [ "$service" = postgres ]; then
      mapped_port postgres 5432
    else
      s3_port=$(mapped_port rustfs 9000)
      s3_readiness_status=0
      wait_for_rustfs_s3 probe_rustfs_s3_from_host rustfsadmin rustfsadmin \
        || s3_readiness_status=$?
      if [ "$s3_readiness_status" -ne 0 ]; then
        echo "RustFS S3 API did not become ready after restart" >&2
        exit "$s3_readiness_status"
      fi
      printf '%s\n' "$s3_port"
    fi
    exit 0
    ;;
  integration | integration-batch-cancel | codex-mcp | benchmark | performance | e2e | agent-eval | image-smoke) ;;
  *)
    echo "usage: $0 {identity|cleanup|stop-postgres|restart-postgres|stop-rustfs|restart-rustfs|integration|integration-batch-cancel|codex-mcp|benchmark|performance|e2e|agent-eval|image-smoke [--keep-environment]}" >&2
    exit 2
    ;;
esac
shift

keep_environment=false
case "${1:-}" in
  '') ;;
  --keep-environment)
    keep_environment=true
    shift
    ;;
  *)
    echo "unknown $command option: $1" >&2
    exit 2
    ;;
esac
test "$#" -eq 0 || {
  echo "$command accepts only --keep-environment" >&2
  exit 2
}

if [ "$command" = agent-eval ]; then
  test "$keep_environment" = false || {
    echo 'agent-eval cannot retain a credential-bearing environment' >&2
    exit 2
  }
  # Paid execution is never selected by any deterministic command. All three
  # credentials are explicitly empty above until this Operator-only branch.
  pnpm --dir "$repo_root/agent" build
  agent_openai_base_url=${THESISTRACE_AGENT_OPENAI_BASE_URL:-}
  agent_openai_api_key=${THESISTRACE_AGENT_OPENAI_API_KEY:-}
  agent_model_registry=$(THESISTRACE_AGENT_OPENAI_API_KEY="$agent_openai_api_key" \
    THESISTRACE_AGENT_OPENAI_BASE_URL="$agent_openai_base_url" \
    node "$repo_root/agent/scripts/eval-research.mjs" configure)
  agent_scripted_model_secret=
  agent_anthropic_api_key=${THESISTRACE_AGENT_ANTHROPIC_API_KEY:-}
  agent_google_api_key=${THESISTRACE_AGENT_GOOGLE_API_KEY:-}
  agent_build_revision=$(git -C "$repo_root" rev-parse HEAD)
fi

