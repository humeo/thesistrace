#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
state_dir="${THESISTRACE_HOST_STATE_DIR:-$root/.hosted}"
env_file="$state_dir/hosted.env"
secret_dir="$state_dir/secrets"
compose_file="$root/deploy/hosted/compose.yaml"
compose_project="${THESISTRACE_COMPOSE_PROJECT_NAME:-thesistrace-hosted}"

random_secret() {
    openssl rand -hex 32
}

environment_value() {
    name="$1"
    sed -n "s/^${name}=//p" "$env_file" | tail -n 1
}

move_secret_to_file() {
    name="$1"
    file_name="$2"
    path="$secret_dir/$file_name"
    if [ ! -f "$path" ]; then
        value="$(environment_value "$name")"
        if [ -z "$value" ]; then
            value="$(random_secret)"
        fi
        umask 077
        printf '%s' "$value" >"$path"
    fi
    chmod 600 "$path"
    temporary="$env_file.secrets.$$"
    sed "/^${name}=/d" "$env_file" >"$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$env_file"
}

prepare() {
    mkdir -p "$state_dir" "$secret_dir"
    chmod 700 "$secret_dir"
    if [ ! -f "$env_file" ]; then
        umask 077
        {
            echo "THESISTRACE_RELEASE_VERSION=0.1.0"
            echo "THESISTRACE_SITE_ADDRESS=https://localhost"
            echo "THESISTRACE_HOSTED_ORIGIN=https://localhost"
            echo "THESISTRACE_SMOKE_INSECURE_TLS=1"
            echo "POSTGRES_PASSWORD=$(random_secret)"
            echo "INSFORGE_JWT_SECRET=$(random_secret)"
            echo "INSFORGE_ENCRYPTION_KEY=$(random_secret)"
            echo "INSFORGE_ADMIN_PASSWORD=$(random_secret)"
            echo "THESISTRACE_API_DATABASE_PASSWORD=$(random_secret)"
            echo "THESISTRACE_OBJECT_STORE_API_TOKEN=$(random_secret)"
        } >"$env_file"
    fi
    chmod 600 "$env_file"
    move_secret_to_file POSTGRES_PASSWORD postgres_password
    move_secret_to_file INSFORGE_JWT_SECRET insforge_jwt_secret
    move_secret_to_file INSFORGE_ENCRYPTION_KEY insforge_encryption_key
    move_secret_to_file INSFORGE_ADMIN_PASSWORD insforge_admin_password
    move_secret_to_file THESISTRACE_API_DATABASE_PASSWORD api_database_password
    move_secret_to_file THESISTRACE_OBJECT_STORE_API_TOKEN object_store_api_token
    move_secret_to_file TUSHARE_TOKEN tushare_token
    printf '{"api":"%s"}' \
        "$(sed -n '1p' "$secret_dir/object_store_api_token")" \
        >"$secret_dir/object_store_tokens"
    chmod 600 "$secret_dir/object_store_tokens"
}

compose() {
    prepare
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
    docker compose \
        --project-name "$compose_project" \
        --file "$compose_file" \
        "$@"
}

smoke() {
    origin="$(environment_value THESISTRACE_HOSTED_ORIGIN)"
    curl_options="--fail --silent --show-error"
    if [ "$(environment_value THESISTRACE_SMOKE_INSECURE_TLS)" = "1" ]; then
        curl_options="$curl_options --insecure"
    fi
    # shellcheck disable=SC2086
    curl $curl_options "$origin/api/health" >/dev/null
}

case "${1:-}" in
    init|config)
        prepare
        printf '%s\n' "$env_file"
        ;;
    deploy|up)
        compose up --detach --build --wait
        ;;
    down)
        compose down
        ;;
    restart)
        compose restart
        ;;
    smoke)
        prepare
        smoke
        ;;
    smtp-configure)
        config_path="${2:?usage: scripts/hosted-stack smtp-configure CONFIG PASSWORD_FILE ACTOR}"
        password_path="${3:?usage: scripts/hosted-stack smtp-configure CONFIG PASSWORD_FILE ACTOR}"
        : "${4:?usage: scripts/hosted-stack smtp-configure CONFIG PASSWORD_FILE ACTOR}"
        compose exec -T api python scripts/hosted/configure_smtp.py \
            --config "$config_path" \
            --smtp-password-file "$password_path" \
            --admin-password-file /run/secrets/insforge_admin_password
        ;;
    operator)
        shift
        compose exec -T api thesistrace-operator "$@"
        ;;
    *)
        echo "usage: scripts/hosted-stack {init|config|deploy|up|down|restart|smoke|smtp-configure|operator}" >&2
        exit 2
        ;;
esac
