#!/bin/sh
set -eu

command=${1:-}
project_name=${2:-}

case "$project_name" in
  thesistrace-dev) ;;
  thesistrace-test-*-lifecycle)
    printf '%s\n' "$project_name" \
      | grep -Eq '^thesistrace-test-[0-9]{8}t[0-9]{6}z-[0-9]+-[0-9a-f]{8}-lifecycle$' \
      || {
        echo "refusing Product State volume project: $project_name" >&2
        exit 2
      }
    ;;
  thesistrace-test-[0-9]*t[0-9]*z-[0-9]*-[0-9a-f]*)
    printf '%s\n' "$project_name" \
      | grep -Eq '^thesistrace-test-[0-9]{8}t[0-9]{6}z-[0-9]+-[0-9a-f]{8}$' \
      || {
        echo "refusing Product State volume project: $project_name" >&2
        exit 2
      }
    ;;
  *)
    echo "refusing Product State volume project: ${project_name:-<empty>}" >&2
    exit 2
    ;;
esac

remove_volume_if_present() {
  volume_name=$1
  if docker volume inspect "$volume_name" >/dev/null 2>&1; then
    docker volume rm "$volume_name"
  fi
}

case "$command" in
  reset)
    remove_volume_if_present "${project_name}_batch-attempt-control"
    remove_volume_if_present "${project_name}_postgres-data"
    remove_volume_if_present "${project_name}_rustfs-data"
    ;;
  erase)
    remove_volume_if_present "${project_name}_batch-attempt-control"
    remove_volume_if_present "${project_name}_postgres-data"
    remove_volume_if_present "${project_name}_rustfs-data"
    remove_volume_if_present "${project_name}_canonical-data"
    ;;
  *)
    echo "usage: $0 {reset|erase} project-name" >&2
    exit 2
    ;;
esac
