#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
canonical_project_name=thesistrace-dev
project_name=${THESISTRACE_DEV_PROJECT_NAME-$canonical_project_name}
base_file="$repo_root/deploy/core/compose.yaml"
development_file="$repo_root/deploy/core/compose.dev.yaml"
environment_file="$repo_root/deploy/core/dev.env"

compose() {
  docker compose \
    --project-name "$project_name" \
    --env-file "$environment_file" \
    --file "$base_file" \
    --file "$development_file" \
    "$@"
}

validate_project() {
  if [ "$project_name" != "$canonical_project_name" ]; then
    shown_name=${project_name:-<empty>}
    echo "refusing non-canonical Development project: $shown_name" >&2
    exit 2
  fi
}

validate_compose() {
  compose config --quiet
}

start() {
  validate_compose
  compose up --detach --build --wait --wait-timeout 300
}

watch_runtime() {
  watch_state=$(mktemp -d "${TMPDIR:-/tmp}/thesistrace-dev-watch.XXXXXX")
  watch_error="$watch_state/stderr"
  interrupted=false
  trap 'interrupted=true' INT TERM

  set +e
  compose up --watch 2>"$watch_error"
  watch_status=$?
  set -e
  trap - INT TERM

  if [ "$interrupted" = true ] \
    && [ "$watch_status" -eq 2 ] \
    && grep -q "panic: close of closed channel" "$watch_error"; then
    watch_status=0
  fi
  if [ "$watch_status" -ne 0 ]; then
    cat "$watch_error" >&2
  fi
  rm -f -- "$watch_error"
  rmdir -- "$watch_state"
  return "$watch_status"
}

validate_project

case "${1:-}" in
  bootstrap)
    cd "$repo_root"
    mise install
    uv sync --frozen
    mise exec -- pnpm install --frozen-lockfile
    validate_compose
    compose pull postgres rustfs
    compose build
    ;;
  up)
    start
    ;;
  watch)
    validate_compose
    watch_runtime
    ;;
  stop)
    validate_compose
    compose stop
    ;;
  logs)
    validate_compose
    compose logs --follow --timestamps
    ;;
  reset)
    validate_compose
    compose down --volumes --remove-orphans
    start
    ;;
  *)
    echo "usage: $0 {bootstrap|up|watch|stop|reset|logs}" >&2
    exit 2
    ;;
esac
