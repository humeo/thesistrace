#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
canonical_project_name=thesistrace-dev
project_name=${THESISTRACE_DEV_PROJECT_NAME-$canonical_project_name}
base_file="$repo_root/deploy/core/compose.yaml"
development_file="$repo_root/deploy/core/compose.dev.yaml"
environment_file=${THESISTRACE_ENV_FILE-"$repo_root/.env"}
product_state_volumes="$repo_root/scripts/product-state-volumes"
. "$repo_root/scripts/runtime-environment"

compose() {
  docker compose \
    --project-name "$project_name" \
    --env-file "$environment_file" \
    --file "$base_file" \
    --file "$development_file" \
    "$@"
}

compose_exec() {
  exec docker compose \
    --project-name "$project_name" \
    --env-file "$environment_file" \
    --file "$base_file" \
    --file "$development_file" \
    "$@"
}

validate_project() {
  if [ "$project_name" != "$canonical_project_name" ]; then
    shown_name=${project_name:-<empty>}
    echo "refusing non-canonical Development project: $shown_name" >&2
    exit 2
  fi
}

validate_compose() {
  THESISTRACE_ENV_FILE="$environment_file" node "$repo_root/scripts/configure.mjs" check
  clear_compose_environment
  THESISTRACE_AGENT_MODEL_REGISTRY=$(cat "$repo_root/config/model-registry.json")
  export THESISTRACE_AGENT_MODEL_REGISTRY
  compose config --quiet
}

start() {
  validate_compose
  compose up --detach --build --wait --wait-timeout 300
}

reset_product_state() {
  validate_compose
  compose down --remove-orphans
  "$product_state_volumes" reset "$project_name"
  start
}

erase_development_environment() {
  validate_compose
  compose down --remove-orphans
  "$product_state_volumes" erase "$project_name"
}

watch_runtime() {
  watch_state=$(mktemp -d "${TMPDIR:-/tmp}/thesistrace-dev-watch.XXXXXX")
  watch_stderr="$watch_state/stderr"
  watch_panic="$watch_state/panic"
  mkfifo "$watch_stderr"
  : >"$watch_panic"

  interrupted=false
  watch_pid=
  trap 'interrupted=true; if [ -n "$watch_pid" ]; then kill -INT "$watch_pid" 2>/dev/null || true; fi' INT
  trap 'interrupted=true; if [ -n "$watch_pid" ]; then kill -TERM "$watch_pid" 2>/dev/null || true; fi' TERM

  (
    buffering=false
    while IFS= read -r line; do
      if [ "$line" = "panic: close of closed channel" ]; then
        buffering=true
      fi
      if [ "$buffering" = true ]; then
        printf '%s\n' "$line" >>"$watch_panic"
      else
        printf '%s\n' "$line" >&2
      fi
    done <"$watch_stderr"
  ) &
  watch_reader_pid=$!

  compose_exec up --watch 2>"$watch_stderr" &
  watch_pid=$!
  set +e
  wait "$watch_pid" 2>/dev/null
  watch_status=$?
  wait "$watch_reader_pid"
  watch_reader_status=$?
  set -e
  trap - INT TERM

  if [ "$interrupted" = true ]; then
    compose stop
  fi
  if [ "$watch_reader_status" -ne 0 ] && [ "$watch_status" -eq 0 ]; then
    watch_status=$watch_reader_status
  fi
  if [ "$interrupted" = true ]; then
    case "$watch_status" in
      0 | 130 | 143) watch_status=0 ;;
      2)
        if grep -q "panic: close of closed channel" "$watch_panic"; then
          watch_status=0
        fi
        ;;
    esac
  fi
  if [ "$watch_status" -ne 0 ] && [ -s "$watch_panic" ]; then
    cat "$watch_panic" >&2
  fi
  rm -f -- "$watch_stderr" "$watch_panic"
  rmdir -- "$watch_state"
  return "$watch_status"
}

validate_project

case "${1:-}" in
  validate)
    validate_compose
    ;;
  bootstrap)
    cd "$repo_root"
    mise install
    uv sync --frozen
    mise exec -- pnpm install --frozen-lockfile
    validate_compose
    compose pull postgres rustfs
    compose build
    ;;
  up)
    start
    ;;
  watch)
    validate_compose
    watch_runtime
    ;;
  stop)
    validate_compose
    compose stop
    ;;
  logs)
    validate_compose
    compose logs --follow --timestamps
    ;;
  reset)
    reset_product_state
    ;;
  erase)
    erase_development_environment
    ;;
  *)
    echo "usage: $0 {validate|bootstrap|up|watch|stop|reset|erase|logs}" >&2
    exit 2
    ;;
esac
