  "constraints": [
    {
      "definition": "PRIMARY KEY (id)",
      "name": "account_pkey",
      "relation": "account",
      "type": "p"
    },
    {
      "definition": "FOREIGN KEY (\"userId\") REFERENCES auth.\"user\"(id) ON DELETE CASCADE",
      "name": "account_userid_fkey",
      "relation": "account",
      "type": "f"
    },
    {
      "definition": "PRIMARY KEY (singleton)",
      "name": "auth_secret_contract_pkey",
      "relation": "auth_secret_contract",
      "type": "p"
    },
    {
      "definition": "CHECK ((secret_fingerprint ~ '^[0-9a-f]{64}$'::text))",
      "name": "auth_secret_contract_secret_fingerprint_check",
      "relation": "auth_secret_contract",
      "type": "c"
    },
    {
      "definition": "CHECK (singleton)",
      "name": "auth_secret_contract_singleton_check",
      "relation": "auth_secret_contract",
      "type": "c"
    },
    {
      "definition": "CHECK ((((status = 'delivery_pending'::text) AND (delivered_at IS NULL) AND (terminal_at IS NULL)) OR ((status = 'delivered'::text) AND (delivered_at IS NOT NULL) AND (terminal_at IS NULL)) OR ((status = ANY (ARRAY['delivery_failed'::text, 'revoked'::text])) AND (terminal_at IS NOT NULL)) OR ((status = 'consumed'::text) AND (delivered_at IS NOT NULL) AND (terminal_at IS NOT NULL))))",
      "name": "password_reset_lifecycle_check",
      "relation": "password_reset",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "password_reset_pkey",
      "relation": "password_reset",
      "type": "p"
    },
    {
      "definition": "CHECK ((status = ANY (ARRAY['delivery_pending'::text, 'delivered'::text, 'delivery_failed'::text, 'consumed'::text, 'revoked'::text])))",
      "name": "password_reset_status_check",
      "relation": "password_reset",
      "type": "c"
    },
    {
      "definition": "CHECK ((octet_length(token_hash) = 32))",
      "name": "password_reset_token_hash_check",
      "relation": "password_reset",
      "type": "c"
    },
    {
      "definition": "UNIQUE (token_hash)",
      "name": "password_reset_token_hash_key",
      "relation": "password_reset",
      "type": "u"
    },
    {
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.\"user\"(id) ON DELETE CASCADE",
      "name": "password_reset_user_id_fkey",
      "relation": "password_reset",
      "type": "f"
    },
    {
      "definition": "UNIQUE (key)",
      "name": "ratelimit_key_key",
      "relation": "rateLimit",
      "type": "u"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "ratelimit_pkey",
      "relation": "rateLimit",
      "type": "p"
    },
    {
      "definition": "CHECK (((email = lower(btrim(email))) AND (char_length(email) <= 254)))",
      "name": "researcher_invitation_email_canonical_check",
      "relation": "researcher_invitation",
      "type": "c"
    },
    {
      "definition": "CHECK ((((status = 'delivery_pending'::text) AND (delivered_at IS NULL) AND (terminal_at IS NULL) AND (user_id IS NULL)) OR ((status = 'delivered'::text) AND (delivered_at IS NOT NULL) AND (terminal_at IS NULL) AND (user_id IS NULL)) OR ((status = ANY (ARRAY['delivery_failed'::text, 'revoked'::text])) AND (terminal_at IS NOT NULL) AND (user_id IS NULL)) OR ((status = 'consumed'::text) AND (delivered_at IS NOT NULL) AND (terminal_at IS NOT NULL) AND (user_id IS NOT NULL))))",
      "name": "researcher_invitation_lifecycle_check",
      "relation": "researcher_invitation",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "researcher_invitation_pkey",
      "relation": "researcher_invitation",
      "type": "p"
    },
    {
      "definition": "CHECK ((status = ANY (ARRAY['delivery_pending'::text, 'delivered'::text, 'delivery_failed'::text, 'consumed'::text, 'revoked'::text])))",
      "name": "researcher_invitation_status_check",
      "relation": "researcher_invitation",
      "type": "c"
    },
    {
      "definition": "CHECK ((octet_length(token_hash) = 32))",
      "name": "researcher_invitation_token_hash_check",
      "relation": "researcher_invitation",
      "type": "c"
    },
    {
      "definition": "UNIQUE (token_hash)",
      "name": "researcher_invitation_token_hash_key",
      "relation": "researcher_invitation",
      "type": "u"
    },
    {
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.\"user\"(id) ON DELETE CASCADE",
      "name": "researcher_invitation_user_id_fkey",
      "relation": "researcher_invitation",
      "type": "f"
    },
    {
      "definition": "PRIMARY KEY (singleton)",
      "name": "schema_contract_pkey",
      "relation": "schema_contract",
      "type": "p"
    },
    {
      "definition": "CHECK ((schema_fingerprint ~ '^[0-9a-f]{64}$'::text))",
      "name": "schema_contract_schema_fingerprint_check",
      "relation": "schema_contract",
      "type": "c"
    },
    {
      "definition": "CHECK (singleton)",
      "name": "schema_contract_singleton_check",
      "relation": "schema_contract",
      "type": "c"
    },
    {
      "definition": "CHECK ((event = ANY (ARRAY['invitation_issued'::text, 'invitation_revoked'::text, 'invitation_accepted'::text, 'sign_in_succeeded'::text, 'sign_in_failed'::text, 'password_reset_requested'::text, 'password_reset_succeeded'::text, 'password_reset_failed'::text, 'password_changed'::text, 'sessions_revoked'::text, 'researcher_deactivated'::text, 'researcher_reactivated'::text, 'display_label_corrected'::text])))",
      "name": "security_audit_event_check",
      "relation": "security_audit",
      "type": "c"
    },
    {
      "definition": "CHECK ((num_nonnulls(researcher_id, unknown_email_hmac) = 1))",
      "name": "security_audit_identity_check",
      "relation": "security_audit",
      "type": "c"
    },
    {
      "definition": "CHECK ((outcome = ANY (ARRAY['succeeded'::text, 'failed'::text, 'rejected'::text, 'no_change'::text])))",
      "name": "security_audit_outcome_check",
      "relation": "security_audit",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "security_audit_pkey",
      "relation": "security_audit",
      "type": "p"
    },
    {
      "definition": "FOREIGN KEY (researcher_id) REFERENCES auth.\"user\"(id) ON DELETE RESTRICT",
      "name": "security_audit_researcher_id_fkey",
      "relation": "security_audit",
      "type": "f"
    },
    {
      "definition": "CHECK (((unknown_email_hmac IS NULL) OR (octet_length(unknown_email_hmac) = 32)))",
      "name": "security_audit_unknown_email_hmac_check",
      "relation": "security_audit",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "session_pkey",
      "relation": "session",
      "type": "p"
    },
    {
      "definition": "UNIQUE (token)",
      "name": "session_token_key",
      "relation": "session",
      "type": "u"
    },
    {
      "definition": "FOREIGN KEY (\"userId\") REFERENCES auth.\"user\"(id) ON DELETE CASCADE",
      "name": "session_userid_fkey",
      "relation": "session",
      "type": "f"
    },
    {
      "definition": "CHECK (((email = lower(btrim(email))) AND (char_length(email) <= 254)))",
      "name": "user_email_canonical_check",
      "relation": "user",
      "type": "c"
    },
    {
      "definition": "UNIQUE (email)",
      "name": "user_email_key",
      "relation": "user",
      "type": "u"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "user_pkey",
      "relation": "user",
      "type": "p"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "verification_pkey",
      "relation": "verification",
      "type": "p"
    }
  ],
