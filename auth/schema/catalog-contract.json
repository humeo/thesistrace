      "parallel": "u",
      "result": "trigger",
      "securityDefiner": false,
      "source": "\nBEGIN\n    PERFORM 1\n    FROM auth.\"user\"\n    WHERE id = NEW.\"userId\" AND active = TRUE\n    FOR UPDATE;\n    IF NOT FOUND THEN\n        RETURN NULL;\n    END IF;\n    RETURN NEW;\nEND;\n",
