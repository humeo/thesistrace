{
  "name": "thesistrace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "THESISTRACE_HOME=../.local concurrently -k -n api,worker,web \"../.venv/bin/thesistrace-api\" \"../.venv/bin/thesistrace-worker\" \"vite --host 127.0.0.1\"",
    "dev:test": "bun run reset:test && THESISTRACE_HOME=.test-workspace TUSHARE_TOKEN= THESISTRACE_API_PORT=8100 THESISTRACE_WEB_PORT=5273 concurrently -k -n api,worker,web \"../.venv/bin/thesistrace-api\" \"../.venv/bin/thesistrace-worker\" \"vite --host 127.0.0.1\"",
    "reset:test": "bun e2e/reset-workspace.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "THESISTRACE_E2E_VIEWPORT=narrow playwright test --reporter=line && THESISTRACE_E2E_VIEWPORT=desktop playwright test --reporter=line",
    "test:e2e:hosted": "playwright test --config=playwright.hosted.config.ts --reporter=line"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
