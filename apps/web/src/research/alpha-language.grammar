@top Formula { Expression? }

@precedence {
  call
  unary
  multiply @left
  add @left
  compare @left
  not
  and @left
  or @left
}

Expression {
  Number |
  FieldName |
  CallExpression |
  ParenthesizedExpression |
  UnaryExpression |
  NotExpression |
  BinaryExpression
}

CallExpression { FunctionName !call "(" ArgumentList? ")" }

FunctionName { Identifier }

FieldName { Identifier }

ArgumentList { Expression ("," Expression)* }

ParenthesizedExpression { "(" Expression ")" }

UnaryExpression { !unary UnaryOperator Expression }
NotExpression { !not NotOperator Expression }

BinaryExpression {
  Expression !multiply MultiplyOperator Expression |
  Expression !add AddOperator Expression |
  Expression !compare ComparisonOperator Expression |
  Expression !and AndOperator Expression |
  Expression !or OrOperator Expression
}

UnaryOperator { "-" }
NotOperator { @specialize<Identifier, "not"> }
AndOperator { @specialize<Identifier, "and"> }
OrOperator { @specialize<Identifier, "or"> }
ComparisonOperator { ">" | ">=" | "<" | "<=" | "==" | "!=" }
MultiplyOperator { "*" | "/" }
AddOperator { "+" | "-" }

@tokens {
  Number { @digit+ ("." @digit+)? }
  Identifier { @asciiLetter (@asciiLetter | @digit | "_")* }
  whitespace { std.whitespace+ }
}

@skip { whitespace }
