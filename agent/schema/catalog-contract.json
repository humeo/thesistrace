  "constraints": [
    {
      "definition": "CHECK (((agent_build_revision = btrim(agent_build_revision)) AND ((char_length(agent_build_revision) >= 1) AND (char_length(agent_build_revision) <= 128))))",
      "name": "agent_run_build_revision_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "CHECK ((model_key ~ '^[a-z0-9][a-z0-9._-]{0,63}$'::text))",
      "name": "agent_run_model_key_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "agent_run_pkey",
      "relation": "agent_run",
      "type": "p"
    },
    {
      "definition": "CHECK (((provider_model_id = btrim(provider_model_id)) AND ((char_length(provider_model_id) >= 1) AND (char_length(provider_model_id) <= 200))))",
      "name": "agent_run_provider_model_id_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "CHECK ((reasoning_effort = ANY (ARRAY['none'::text, 'minimal'::text, 'low'::text, 'medium'::text, 'high'::text, 'xhigh'::text])))",
      "name": "agent_run_reasoning_effort_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "CHECK ((octet_length(request_fingerprint) = 32))",
      "name": "agent_run_request_fingerprint_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "CHECK ((status = ANY (ARRAY['running'::text, 'completed'::text, 'failed'::text])))",
      "name": "agent_run_status_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "CHECK ((((status = 'running'::text) AND (completed_at IS NULL) AND (token_usage IS NULL) AND (terminal_error_code IS NULL)) OR ((status = 'completed'::text) AND (completed_at IS NOT NULL) AND (token_usage IS NOT NULL) AND (terminal_error_code IS NULL)) OR ((status = 'failed'::text) AND (completed_at IS NOT NULL) AND (token_usage IS NOT NULL) AND (terminal_error_code IS NOT NULL))))",
      "name": "agent_run_terminal_check",
      "relation": "agent_run",
      "type": "c"
    },
    {
      "definition": "FOREIGN KEY (thread_id) REFERENCES agent.chat_session(id) ON DELETE CASCADE",
      "name": "agent_run_thread_id_fkey",
      "relation": "agent_run",
      "type": "f"
    },
    {
      "definition": "CHECK ((selected_model_key ~ '^[a-z0-9][a-z0-9._-]{0,63}$'::text))",
      "name": "chat_session_model_key_check",
      "relation": "chat_session",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "chat_session_pkey",
      "relation": "chat_session",
      "type": "p"
    },
    {
      "definition": "CHECK ((selected_reasoning_effort = ANY (ARRAY['none'::text, 'minimal'::text, 'low'::text, 'medium'::text, 'high'::text, 'xhigh'::text])))",
      "name": "chat_session_reasoning_effort_check",
      "relation": "chat_session",
      "type": "c"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "name": "mastra_messages_pkey",
