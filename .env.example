# Generated from tooling/config/fields.mjs. Run pnpm config:init to create a private .env.
# Single-line literals only: no $, #, outer quotes or inline comments.
# THESISTRACE_ENV_FILE selects the authoritative file. Ambient deployment values are ignored.


# Deployment identity and published loopback ports
THESISTRACE_ENVIRONMENT=development
THESISTRACE_PUBLIC_ORIGIN=http://127.0.0.1:5173
THESISTRACE_DEV_POSTGRES_PORT=55432
THESISTRACE_DEV_S3_PORT=59010
THESISTRACE_DEV_S3_CONSOLE_PORT=59011
THESISTRACE_DEV_API_PORT=8100
THESISTRACE_AUTH_IMAGE=thesistrace-auth-dev
THESISTRACE_AGENT_IMAGE=thesistrace-agent-dev
THESISTRACE_AGENT_BUILD_REVISION=development

# Generated once by config:init. Preserve passwords for an existing database.
THESISTRACE_OWNER_DATABASE_PASSWORD=
THESISTRACE_CORE_DATABASE_PASSWORD=
THESISTRACE_AUTH_DATABASE_PASSWORD=
THESISTRACE_AGENT_DATABASE_PASSWORD=
THESISTRACE_S3_ACCESS_KEY_ID=
THESISTRACE_S3_SECRET_ACCESS_KEY=
BETTER_AUTH_SECRET=
THESISTRACE_MCP_SIGNING_PRIVATE_JWK=
THESISTRACE_MCP_VERIFYING_PUBLIC_JWK=

# Created only when this Development identity is absent; never resets an account.
THESISTRACE_DEV_RESEARCHER_EMAIL=operator@thesistrace.local
THESISTRACE_DEV_RESEARCHER_NAME=Local Operator
THESISTRACE_DEV_RESEARCHER_PASSWORD=

# External services. Supply your own credentials; these are never generated.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
THESISTRACE_RESEND_API_URL=https://api.resend.com
THESISTRACE_TUSHARE_TOKEN=
THESISTRACE_AGENT_OPENAI_API_KEY=
THESISTRACE_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
THESISTRACE_AGENT_ANTHROPIC_API_KEY=
THESISTRACE_AGENT_GOOGLE_API_KEY=

# Worker capacity: threads <= CPUs, execution memory <= 3/4 of memory.
THESISTRACE_RESEARCH_WORKER_EXECUTION_MEMORY_BYTES=1610612736
THESISTRACE_TRACKING_WORKER_EXECUTION_MEMORY_BYTES=1610612736

# Model definitions are maintained only in config/model-registry.json.
THESISTRACE_AGENT_RUN_MAX_WALL_SECONDS=600
THESISTRACE_MCP_ACCESS_TOKEN_TTL_SECONDS=660
THESISTRACE_MCP_AGENT_SCOPES=["research:read","research:execute","tracking:read","tracking:execute"]
THESISTRACE_MCP_CLIENT_ID=thesistrace-agent
THESISTRACE_MCP_CLOCK_SKEW_SECONDS=30
THESISTRACE_MCP_DEPLOYMENT_TOOLS=["diagnose_alpha_formula","get_alpha_catalog","get_daily_track","get_daily_track_result","get_research_batch","get_research_context","get_research_run","get_research_run_result","list_daily_tracks","list_research_batches","list_research_runs","refresh_daily_track","retry_daily_track","start_daily_track","submit_research_batch","submit_research_run"]

# Worker capacity: threads <= CPUs, execution memory <= 3/4 of memory.
THESISTRACE_RESEARCH_WORKER_CPU_COUNT=2
THESISTRACE_RESEARCH_WORKER_MEMORY_BYTES=2147483648
THESISTRACE_RESEARCH_WORKER_CALCULATION_THREADS=2
THESISTRACE_BATCH_RESEARCH_WORKER_CPU_COUNT=2
THESISTRACE_BATCH_RESEARCH_WORKER_MEMORY_BYTES=2147483648
THESISTRACE_BATCH_RESEARCH_WORKER_EXECUTION_MEMORY_BYTES=1610612736
THESISTRACE_BATCH_RESEARCH_WORKER_CALCULATION_THREADS=2
THESISTRACE_TRACKING_WORKER_CPU_COUNT=2
THESISTRACE_TRACKING_WORKER_MEMORY_BYTES=2147483648
THESISTRACE_TRACKING_WORKER_CALCULATION_THREADS=2
